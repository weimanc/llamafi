.pio/
.vscode/

# Runtime credentials and data — never commit.
# data/ is symlinked to Spotify-Diy-Thing/data/ (gitignored at root),
# but wildcard here covers any future credential file if symlink changes.
data/*
!data/.gitkeep

# Hardcoded WiFi creds (opt-in shim).
src/wifi_creds.h

# Host-only bake review artefacts.
gen/skin_preview.png
gen/skin_hitzones.png
gen/origin_audit.png
gen/composite/
gen/vis_atlas.npy
gen/wave_atlas.npy

# Python bytecode.
**/__pycache__/

# Soak/probe scratch output — regenerated per run, not a committed artifact.
tools/rnd_logs/

# TASK-608 / IFC-008: per-run result artifacts. One file per run, uniquely
# named, never overwritten (that uniqueness IS the staleness guard) — evidence
# of a run, not of the tree. Nothing reads this directory by name; a consumer
# that needs an artifact names its own path via RESULTS_JSON.
tools/.runs/
