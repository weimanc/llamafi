# Regenerated by test_check_no_reachable_fail.py on every run. It is written to a
# real file rather than exec'd from a string because the R34 gate reads SOURCE
# via inspect.getsource() — an in-memory module would not exercise the thing
# under test. Not committed: the fixture's authority is the SYNTH constant in
# the test, and a committed copy could drift from it silently.
_r34_synthetic.py
