# run/local.env.example — copy to run/local.env (gitignored) to enable
# machine-local settings. run/lib.sh sources run/local.env if it exists;
# a checkout with no such file behaves exactly as it did before TASK-677.
#
#   cp run/local.env.example run/local.env
#   $EDITOR run/local.env

# TASK-677 / PROP-011 §5 P0 — turn on host+DUT fault correlation (rigwatch):
# a kernel-USB-event daemon, harness event stamps on every flash/monitor/test
# action, host-timestamped DUT serial lines, and a `rig` section in the run
# artifact. Off (0) by default even with this file present, so uncomment
# deliberately.
# export RIGWATCH=1

# The DUT's device node, used once to resolve its USB *topology* port (e.g.
# "1-1") — rigwatch filters the kernel log to that port so an unrelated USB
# device (this rig has a fingerprint reader on a different port) never shows
# up as a DUT event. A /dev/serial/by-id/usb-1a86_* path is typical; see
# `ls /dev/serial/by-id/`. Leave unset to let rigwatch pick the first CH340
# by-id node it finds — fine for a single-DUT rig, ambiguous with two.
# export DUT_BY_PATH=/dev/serial/by-id/usb-1a86_USB2.0-Serial-if00-port0
