#!/usr/bin/env bash
# run/monitor-read — dump last N lines from tmux monitor pane
# Usage: ./run/monitor-read [lines]   (default 200)
set -euo pipefail
source "$(dirname "$0")/lib.sh"
N="${1:-200}"
tmux capture-pane -t "$SESSION" -p -S "-$N" 2>/dev/null \
  || { echo "ERROR: session '$SESSION' not running" >&2; exit 1; }
