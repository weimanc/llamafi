#!/usr/bin/env bash
# run/ae04 — TASK-409 / ADR-059 T_AE_04: teardown ordering under eject-mid-CONNECTING.
# Flashes the Spotify-DISABLED build (cyd2usb_webradio — same MEMBUDGET_PHASE1 arena
# and debug instrumentation as run/wr-soak uses), injects a dead station URL, ejects
# mid-CONNECTING x10 and checks pump -> Audio -> arena teardown ordering, arena
# balance and the loopTask non-block invariant. Restores production firmware +
# monitor on exit.
#
# NEVER kill this mid-flight (timeout/Ctrl-C/host suspend) — the trap-guarded prod
# restore races and can leave the DUT boot-looping. ~4 min total.
#
# Usage: ./run/ae04            # 10 cycles (T_AE_04's exit criterion)
#        ./run/ae04 3          # 3 cycles (quick smoke)
set -euo pipefail
source "$(dirname "$0")/lib.sh"
CYCLES="${CYCLES:-${1:-10}}"
ENV_AE04="cyd2usb_webradio"     # Spotify-disabled; same arena + debug build as wr-soak
PORT=$(resolve_port)

# ADR-067/TASK-633: declare the build this run needs and READ THE BOARD.
# Refuses with exit 3 (RIG, `elf-mismatch`) if they differ. Runs before the
# monitor is touched, so a refused run leaves the rig as it found it.
require_build "$ENV_AE04" ae04 "$PORT" || exit $?

_RC=0
_cleanup() {
  local rc=$_RC
  echo ""
  # ADR-067 D1: the production restore that used to run here is DELETED,
  # not guarded. A test entry point does not own firmware lifecycle. The
  # board keeps whatever build the last flash put there.
  echo "[ae04] restarting monitor"
  restart_monitor "$PORT"
  exit "$rc"
}
trap _cleanup EXIT INT TERM

echo "[ae04] 1/4 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

echo "[ae04] 2/4 — build already verified; NOT flashing (ADR-067)"
# ADR-067 D1: no flash here. require_build() above read the board and
# refused with exit 3 if it was not running the build this run needs.
# Flashing is the caller's explicit action, through run/flash*.

echo "[ae04] 3/4 — waiting ${BOOT_WAIT}s for boot + WiFi"
# DO NOT delete this sleep (TASK-563). Unlike the run/test* scripts, this one
# drives a tool that opens a RAW serial.Serial rather than lib.dut.Dut, so it
# never consults the reset-gap file and stamp_reset_gap() would be a no-op
# here. This sleep is therefore the ONLY thing separating esptool's reset
# from the port open -- removing it re-opens TASK-559 in this script.
# Fix properly by migrating the tool onto Dut (design OQ5), not by deleting.
sleep "$BOOT_WAIT"

echo "[ae04] 4/4 — running T_AE_04, ${CYCLES} cycles"
(cd "$PIO_DIR" && "$VENV_PY" tools/test_ae04_teardown.py \
    --port "$PORT" --cycles "$CYCLES") \
  || _RC=$?
