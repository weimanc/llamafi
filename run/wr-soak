#!/usr/bin/env bash
# run/wr-soak — unattended WebRadio playback + A-lite arena-churn soak (TASK-271)
# Flashes the Spotify-DISABLED build (cyd2usb_webradio — no TASK-243 403 fetch
# starvation, so stations actually load + play), soaks the play/leave cycle to churn
# the JIT decoder arena, prints an arena-fragmentation + playback report, then restores
# production firmware + monitor. The arena code is identical to production
# (both -DMEMBUDGET_PHASE1); only Spotify differs.
#
# Usage: ./run/wr-soak            # 10-min soak (default)
#        ./run/wr-soak 5          # 5-min soak
#        MINUTES=20 PLAY_SECS=30 ./run/wr-soak
set -euo pipefail
source "$(dirname "$0")/lib.sh"
MINUTES="${MINUTES:-${1:-10}}"
PLAY_SECS="${PLAY_SECS:-20}"
ENV_SOAK="cyd2usb_webradio"     # Spotify-disabled; same MEMBUDGET_PHASE1 arena as prod
PORT=$(resolve_port)

# ADR-067/TASK-633: declare the build this run needs and READ THE BOARD.
# Refuses with exit 3 (RIG, `elf-mismatch`) if they differ. Runs before the
# monitor is touched, so a refused run leaves the rig as it found it.
require_build "$ENV_SOAK" wr-soak "$PORT" || exit $?

_RC=0
_cleanup() {
  local rc=$_RC
  echo ""
  # ADR-067 D1: the production restore that used to run here is DELETED,
  # not guarded. A test entry point does not own firmware lifecycle. The
  # board keeps whatever build the last flash put there.
  echo "[wr-soak] restarting monitor"
  restart_monitor "$PORT"
  exit "$rc"
}
trap _cleanup EXIT INT TERM

echo "[wr-soak] 1/4 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

echo "[wr-soak] 2/4 — build already verified; NOT flashing (ADR-067)"
# ADR-067 D1: no flash here. require_build() above read the board and
# refused with exit 3 if it was not running the build this run needs.
# Flashing is the caller's explicit action, through run/flash*.

echo "[wr-soak] 3/4 — waiting ${BOOT_WAIT}s for boot + WiFi"
# DO NOT delete this sleep (TASK-563). Unlike the run/test* scripts, this one
# drives a tool that opens a RAW serial.Serial rather than lib.dut.Dut, so it
# never consults the reset-gap file and stamp_reset_gap() would be a no-op
# here. This sleep is therefore the ONLY thing separating esptool's reset
# from the port open -- removing it re-opens TASK-559 in this script.
# Fix properly by migrating the tool onto Dut (design OQ5), not by deleting.
sleep "$BOOT_WAIT"

echo "[wr-soak] 4/4 — soaking ${MINUTES} min (${PLAY_SECS}s/station)"
(cd "$PIO_DIR" && "$VENV_PY" tools/test_webradio_soak.py \
    --port "$PORT" --minutes "$MINUTES" --play-secs "$PLAY_SECS" \
    ${WR_SOAK_VERBOSE:+--verbose} ${INJECT_URL:+--inject-url "$INJECT_URL"}) \
  || _RC=$?
