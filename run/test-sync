#!/usr/bin/env bash
# run/test-sync — sync/drift/playlist suite (T097-T116) — requires DUT
# Uses run_sync_tests.py (separate runner from run_serialdbg_tests.py).
# Runs the full 6-step validation loop with trap-guarded prod restore.
# Usage: ./run/test-sync
#        BOOT_WAIT=12 ./run/test-sync
#        PORT=/dev/ttyUSB1 ./run/test-sync
set -euo pipefail
source "$(dirname "$0")/lib.sh"
PORT=$(resolve_port)

_TEST_RC=0
_cleanup() {
  local rc=$_TEST_RC
  echo ""
  echo "[test-sync] step 5/6 — restoring $ENV_PROD (rc=$rc so far)"
  (cd "$PIO_DIR" && "$PIO" run -e "$ENV_PROD" -t upload --upload-port "$PORT") || {
    echo "ERROR [test-sync]: prod restore failed" >&2
    rc=99
  }
  echo "[test-sync] step 6/6 — restarting monitor"
  tmux new-session -d -s "$SESSION" \
    "cd '$PIO_DIR' && '$PIO' device monitor -e '$ENV_PROD' -p '$PORT'" \
    2>/dev/null || true
  exit "$rc"
}
trap _cleanup EXIT INT TERM

echo "[test-sync] step 1/6 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

echo "[test-sync] step 2/6 — flashing $ENV_DEBUG to $PORT"
(cd "$PIO_DIR" && "$PIO" run -e "$ENV_DEBUG" -t upload --upload-port "$PORT")

echo "[test-sync] step 3/6 — waiting ${BOOT_WAIT}s for boot + WiFi"
sleep "$BOOT_WAIT"

echo "[test-sync] step 4/6 — running sync/drift/playlist suite (T097-T116)"
(cd "$PIO_DIR" && "$VENV_PY" tools/run_sync_tests.py --port "$PORT") \
  || _TEST_RC=$?
