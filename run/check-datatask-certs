#!/usr/bin/env python3
# run/check-datatask-certs — dataTask TLS chain preflight
#
# ADR-029's quarterly check (BP-030) only greps the cert *issuer* string, which
# doesn't tell you whether the server actually sends a chain mbedTLS can build
# offline (no AIA fetching, single pinned root). That gap let TASK-214's
# "radio-browser.info omits the R13 intermediate" diagnosis go unverified on
# host before landing setInsecure() as a permanent fix.
#
# This script replicates the exact verification ESP32 WiFiClientSecure::
# setCACert() performs: strict, offline, single-root chain build against
# whatever cert(s) the server actually presents in the handshake — via
#   openssl s_client -CAfile <root-only> -verify_return_error
# for every (endpoint, root CA) pair this firmware pins. Root CA PEMs are
# parsed directly out of app/src/dataTaskCerts.h so this can never drift from
# what firmware actually ships.
#
# Usage:
#   ./run/check-datatask-certs
#   ./run/check-datatask-certs --expiry-only     # TASK-342: offline, no network, no gate
#   ./run/check-datatask-certs --propose-fix     # TASK-343: on FAIL, write a scratch/ report
#   ./run/check-datatask-certs --certs-file PATH # override cert header (testing)
#
# Exits 0 if every endpoint's chain verifies; 1 if any fails or errors.
# --expiry-only always exits 0 (warn-only by design — see TASK-342).

import argparse
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

PROJ_ROOT = Path(__file__).resolve().parent.parent
CERTS_H = PROJ_ROOT / "app" / "src" / "dataTaskCerts.h"
TIMEOUT_S = 10

# (display host, root CA constant name as used in dataTaskStorage.cpp)
ENDPOINTS = [
    ("api.open-meteo.com", "OPEN_METEO_ROOT_CA"),
    ("query1.finance.yahoo.com", "YAHOO_FINANCE_ROOT_CA"),
    ("api.coingecko.com", "COINGECKO_ROOT_CA"),
    ("teletekst-data.nos.nl", "TELETEXT_NOS_ROOT_CA"),
    ("de1.api.radio-browser.info", "RADIO_BROWSER_ROOT_CA"),
    ("nl1.api.radio-browser.info", "RADIO_BROWSER_ROOT_CA"),
    ("at1.api.radio-browser.info", "RADIO_BROWSER_ROOT_CA"),
    ("opendata.adsb.fi", "PLANERADAR_ROOT_CA"),
    # nominatim.openstreetmap.org (M-PR-LOCATIONS geocode lookup): chain
    # verified against OPEN_METEO_ROOT_CA by TASK-315's phase-0 probe
    # (docs/architecture/designs/M-PR-LOCATIONS/phase0-geocode-probe.md).
    # NOMINATIM_ROOT_CA is a same-cert #define alias (radio-browser pattern),
    # landed with TASK-320. Its chain reaches X1 only via a cross-signed
    # ISRG Root YR — a FAIL here most likely means OSM dropped the
    # cross-sign; remediation is a two-root bundle (see dataTaskCerts.h).
    ("nominatim.openstreetmap.org", "NOMINATIM_ROOT_CA"),
]

# Cert constants referenced above that are expected to be missing until a
# specific future task lands them (see comment at the ENDPOINTS entry). A
# missing constant here prints PENDING and does not fail the gate; a missing
# constant NOT in this dict still prints ERROR as before — this only silences
# the specific, tracked, not-yet-landed case. (NOMINATIM_ROOT_CA graduated
# 2026-07-14 when TASK-320 landed the alias — dict kept for the next pin.)
PENDING_CERTS = {}

BLOCK_RE = re.compile(
    r'static const char (\w+)\[\]\s*=\s*R"EOF\((.*?)\)EOF";', re.DOTALL
)
ALIAS_RE = re.compile(r"^#define\s+(\w+_ROOT_CA)\s+(\w+)\s*$", re.MULTILINE)


def load_certs(certs_h: Path = CERTS_H):
    text = certs_h.read_text()
    certs = {name: pem.strip() + "\n" for name, pem in BLOCK_RE.findall(text)}
    for alias, target in ALIAS_RE.findall(text):
        if target in certs:
            certs[alias] = certs[target]
    return certs


# TASK-342: fully offline expiry check — no network, deterministic, cheap
# enough to run unconditionally (unlike strict_verify() above). Parses each
# pinned PEM's notAfter locally via `openssl x509 -enddate` and warns when a
# root is within warn_days of expiry. Current roster expires 2035-2038 (see
# design doc), so this is silent for years; it exists to catch a short-lived
# root/intermediate mistakenly pinned in a future rotation.
def check_expiry(certs: dict, warn_days: int = 180) -> list[tuple[str, int]]:
    warned = []
    seen_pems = set()
    for name, pem in certs.items():
        if pem in seen_pems:
            continue  # alias of an already-checked cert (e.g. NOMINATIM_ROOT_CA)
        seen_pems.add(pem)
        try:
            proc = subprocess.run(
                ["openssl", "x509", "-enddate", "-noout"],
                input=pem, capture_output=True, text=True, timeout=5,
            )
        except (subprocess.TimeoutExpired, FileNotFoundError) as e:
            print(f"ERROR {name:32s} — expiry check failed: {e}")
            continue
        m = re.search(r"notAfter=(.+)", proc.stdout)
        if not m:
            print(f"ERROR {name:32s} — could not parse notAfter ({proc.stderr.strip()})")
            continue
        try:
            expiry = datetime.strptime(m.group(1).strip(), "%b %d %H:%M:%S %Y %Z")
        except ValueError as e:
            print(f"ERROR {name:32s} — could not parse expiry date {m.group(1)!r}: {e}")
            continue
        expiry = expiry.replace(tzinfo=timezone.utc)
        days_left = (expiry - datetime.now(timezone.utc)).days
        if days_left < warn_days:
            print(f"WARN  {name:32s} expires in {days_left} days ({expiry.date()})")
            warned.append((name, days_left))
    return warned


def strict_verify(host: str, pem: str) -> tuple[str, str]:
    """Returns (status, detail). status in {PASS, FAIL, ERROR}."""
    with tempfile.NamedTemporaryFile("w", suffix=".pem", delete=False) as f:
        f.write(pem)
        ca_path = f.name
    try:
        proc = subprocess.run(
            [
                "openssl", "s_client",
                "-connect", f"{host}:443",
                "-servername", host,
                "-CAfile", ca_path,
                "-verify_return_error",
            ],
            input="",
            capture_output=True,
            text=True,
            timeout=TIMEOUT_S,
        )
    except subprocess.TimeoutExpired:
        return "ERROR", "timed out"
    except FileNotFoundError:
        return "ERROR", "openssl not on PATH"
    finally:
        Path(ca_path).unlink(missing_ok=True)

    out = proc.stdout + proc.stderr
    if "Name or service not known" in out or "Connection refused" in out:
        return "ERROR", "network unreachable from this host"
    m = re.search(r"Verify return code: (\d+) \(([^)]+)\)", out)
    if not m:
        return "ERROR", "no verify result in openssl output"
    code, msg = m.group(1), m.group(2)
    if code == "0":
        return "PASS", msg
    return "FAIL", f"verify code {code} ({msg})"


# TASK-343: --propose-fix support. Never applies anything to dataTaskCerts.h —
# TOFU risk (design doc §3): auto-trusting whatever a live server presents
# would let a build-time MITM bake itself into firmware, and single probes are
# unreliable evidence on their own (coingecko's Cloudflare edge flip-flopped
# between two valid root chains twice, TASK-298 — an auto-updater watching one
# probe would have "corrected" the two-root bundle fix right back into the
# breakage it fixed). This only writes a report; a human reads it, verifies
# the fingerprint against CCADB/Mozilla, and edits dataTaskCerts.h by hand.

CERT_SPLIT_RE = re.compile(
    r"-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----", re.DOTALL
)


def fetch_served_chain(host: str) -> list[str]:
    """Returns the raw PEM cert chain the server presents, WITHOUT verifying
    it against any pinned root (no -CAfile) — this is "what's actually being
    served right now", independent of whether it validates against what we
    currently pin. Ordered leaf-first, as sent."""
    proc = subprocess.run(
        ["openssl", "s_client", "-connect", f"{host}:443",
         "-servername", host, "-showcerts"],
        input="", capture_output=True, text=True, timeout=TIMEOUT_S,
    )
    return CERT_SPLIT_RE.findall(proc.stdout)


def describe_cert(pem: str) -> dict:
    proc = subprocess.run(
        ["openssl", "x509", "-noout", "-subject", "-issuer",
         "-fingerprint", "-sha256", "-enddate"],
        input=pem, capture_output=True, text=True, timeout=5,
    )
    out = proc.stdout
    subject = re.search(r"subject=(.+)", out)
    issuer = re.search(r"issuer=(.+)", out)
    fingerprint = re.search(r"Fingerprint=(.+)", out)
    enddate = re.search(r"notAfter=(.+)", out)
    d = {
        "subject": subject.group(1).strip() if subject else "?",
        "issuer": issuer.group(1).strip() if issuer else "?",
        "fingerprint": fingerprint.group(1).strip() if fingerprint else "?",
        "notafter": enddate.group(1).strip() if enddate else "?",
        "pem": pem.strip(),
    }
    d["self_signed"] = d["subject"] == d["issuer"]
    return d


def write_propose_fix_report(host: str, cert_name: str, detail: str,
                              scratch_dir: Path) -> Path:
    """Fetches the chain currently served by `host` (independent of our
    pinned root) and writes a human-review report naming the candidate root.
    Returns the report path. Caller decides when to call this (on FAIL)."""
    scratch_dir.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    report_path = scratch_dir / f"cert-propose-fix-{cert_name}-{ts}.md"

    chain_pems = fetch_served_chain(host)
    lines = [
        f"# Cert rotation proposal — {cert_name} ({host})",
        "",
        f"Generated {datetime.now().isoformat(timespec='seconds')} by "
        f"`run/check-datatask-certs --propose-fix`.",
        "",
        f"**Preflight verify failed:** {detail}",
        "",
    ]

    if not chain_pems:
        lines.append("Could not fetch the served chain (network error or "
                      "openssl failure) — nothing to propose. Re-run from an "
                      "unrestricted network.")
    else:
        candidates = [describe_cert(p) for p in chain_pems]
        top = candidates[-1]   # topmost cert the server presented
        if top["self_signed"]:
            lines.append("**Candidate root (self-signed — the server sent the "
                          "actual root):**")
        else:
            lines.append(
                "**Chain terminates in a root we don't have.** The server did "
                "NOT send the actual root (topmost cert below is not "
                "self-signed) — its `issuer` line names the root you need to "
                "source separately from the CA's published root store "
                "(CCADB/Mozilla), it is NOT in the PEM block below."
            )
        lines += [
            "",
            f"- subject: `{top['subject']}`",
            f"- issuer: `{top['issuer']}`",
            f"- sha256 fingerprint: `{top['fingerprint']}`",
            f"- notAfter: `{top['notafter']}`",
            "",
            "Ready-to-paste PEM block (topmost cert served — see self-signed "
            "note above for whether this IS the root or just the nearest "
            "cert to it we have):",
            "",
            "```",
            top["pem"],
            "```",
            "",
            f"Full served chain was {len(candidates)} cert(s) deep (leaf-first); "
            "only the topmost is shown above.",
        ]

    lines += [
        "",
        "## Two mandatory judgement calls before touching `dataTaskCerts.h`",
        "",
        "1. **Verify the fingerprint** against the CA's own published root "
        "(CCADB or the Mozilla root store) — do not trust this probe alone. "
        "A build-time MITM would produce a plausible-looking report too.",
        "2. **Replace vs. bundle**: decide based on whether the OLD pinned "
        "root still appears on repeat probes (a different network, a "
        "different day). coingecko's Cloudflare edge flip-flopped between "
        "two valid root chains twice (TASK-298) — replacing the pin outright "
        "on a single probe would have reintroduced that exact breakage. If "
        "both roots are still live, bundle (both roots' PEMs), don't replace.",
        "",
        "This report never touches `dataTaskCerts.h` — that edit is yours to "
        "make by hand, then re-run this checker to confirm PASS.",
        "",
    ]
    report_path.write_text("\n".join(lines))
    return report_path


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--expiry-only", action="store_true",
                         help="Skip network chain verification; run only the offline PEM "
                              "expiry check (TASK-342). Always exits 0 — warn-only.")
    parser.add_argument("--expiry-warn-days", type=int, default=180,
                         help="Warn threshold in days for --expiry-only (default: 180).")
    parser.add_argument("--certs-file", type=Path, default=CERTS_H,
                         help="Override path to the cert header (default: "
                              "app/src/dataTaskCerts.h). For testing (T_CERT_HOST_02).")
    parser.add_argument("--propose-fix", action="store_true",
                         help="On FAIL, fetch the served chain and write a human-review "
                              "report to --scratch-dir (TASK-343). Never edits "
                              "dataTaskCerts.h — proposal only.")
    parser.add_argument("--scratch-dir", type=Path, default=PROJ_ROOT / "scratch",
                         help="Where --propose-fix writes reports (default: scratch/). "
                              "For testing (T_CERT_HOST_01).")
    args = parser.parse_args()

    certs_h = args.certs_file
    if not certs_h.exists():
        print(f"FAIL  cert header not found: {certs_h}", file=sys.stderr)
        return 1

    certs = load_certs(certs_h)

    if args.expiry_only:
        check_expiry(certs, args.expiry_warn_days)
        return 0

    results = []
    for host, cert_name in ENDPOINTS:
        pem = certs.get(cert_name)
        if not pem:
            pending_task = PENDING_CERTS.get(cert_name)
            if pending_task:
                status, detail = "PENDING", f"{cert_name} not defined yet — lands with {pending_task}"
            else:
                status, detail = "ERROR", f"{cert_name} not found in {certs_h.name}"
            results.append((host, cert_name, status, detail))
            print(f"{status:5s} {host:32s} ({cert_name}) — {detail}")
            continue
        status, detail = strict_verify(host, pem)
        results.append((host, cert_name, status, detail))
        print(f"{status:5s} {host:32s} ({cert_name}) — {detail}")
        if status == "FAIL" and args.propose_fix:
            report_path = write_propose_fix_report(host, cert_name, detail, args.scratch_dir)
            print(f"      -> propose-fix report: {report_path}")

    failures = [r for r in results if r[2] not in ("PASS", "PENDING")]
    print()
    if failures:
        print(f"FAIL  {len(failures)}/{len(results)} endpoint(s) did not verify cleanly against the pinned root.")
        print("      A FAIL here means firmware's setCACert() path will not work as-is for that")
        print("      endpoint right now — either the chain is genuinely incomplete server-side,")
        print("      or the pinned root/constant is wrong. An ERROR may just mean this network")
        print("      can't reach the host (sandboxed/offline) — re-run from an unrestricted network")
        print("      before concluding the chain itself is broken.")
        return 1

    pending = [r for r in results if r[2] == "PENDING"]
    verified = len(results) - len(pending)
    suffix = f" ({len(pending)} PENDING, tracked separately — see comment)" if pending else ""
    print(f"PASS  all {verified} verifiable endpoint(s) verify cleanly against their pinned root CA.{suffix}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
