#!/usr/bin/env bash
# run/pr-fetch-soak — PlaneRadar fetch-failure-rate soak (TASK-361 quantification)
# Flashes the debug build, switches to PlaneRadar, watches the
# [dataTask.planeradar] log lines (size=/scanned= fields added by TASK-361)
# over the soak window, and prints a failure-rate-by-payload-size report —
# then restores production firmware + monitor.
#
# Best run during real busy-traffic hours (daytime) — TASK-361's regression
# was only observed under 60-70 real aircraft; a quiet-traffic run is a valid
# but less informative data point.
#
# Usage: ./run/pr-fetch-soak            # 30-min soak (default)
#        ./run/pr-fetch-soak 10         # 10-min soak
#        MINUTES=60 ./run/pr-fetch-soak
set -euo pipefail
source "$(dirname "$0")/lib.sh"
MINUTES="${MINUTES:-${1:-30}}"
PORT=$(resolve_port)

_RC=0
_cleanup() {
  local rc=$_RC
  echo ""
  echo "[pr-fetch-soak] restoring $ENV_PROD (rc=$rc so far)"
  (cd "$PIO_DIR" && "$PIO" run -e "$ENV_PROD" -t upload --upload-port "$PORT") || {
    echo "ERROR [pr-fetch-soak]: prod restore failed" >&2; rc=99; }
  echo "[pr-fetch-soak] restarting monitor"
  tmux new-session -d -s "$SESSION" \
    "cd '$PIO_DIR' && '$PIO' device monitor -e '$ENV_PROD' -p '$PORT'" \
    2>/dev/null || true
  exit "$rc"
}
trap _cleanup EXIT INT TERM

echo "[pr-fetch-soak] 1/4 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

echo "[pr-fetch-soak] 2/4 — flashing $ENV_DEBUG to $PORT"
(cd "$PIO_DIR" && "$PIO" run -e "$ENV_DEBUG" -t upload --upload-port "$PORT")

echo "[pr-fetch-soak] 3/4 — waiting ${BOOT_WAIT}s for boot + WiFi"
sleep "$BOOT_WAIT"

echo "[pr-fetch-soak] 4/4 — soaking ${MINUTES} min"
(cd "$PIO_DIR" && "$VENV_PY" tools/pr_fetch_soak_report.py --port "$PORT" --minutes "$MINUTES") \
  || _RC=$?
