#!/usr/bin/env bash
# run/pr-fetch-soak — PlaneRadar fetch-failure-rate soak (TASK-361 quantification)
# Flashes the debug build, switches to PlaneRadar, watches the
# [dataTask.planeradar] log lines (size=/scanned= fields added by TASK-361)
# over the soak window, and prints a failure-rate-by-payload-size report —
# then restores production firmware + monitor.
#
# Best run during real busy-traffic hours (daytime) — TASK-361's regression
# was only observed under 60-70 real aircraft; a quiet-traffic run is a valid
# but less informative data point.
#
# Usage: ./run/pr-fetch-soak            # 30-min soak (default), current prloc
#        ./run/pr-fetch-soak 10         # 10-min soak
#        MINUTES=60 ./run/pr-fetch-soak
#        LOC_SLOT=6 LAT=22.308 LON=113.915 LABEL=HKG ./run/pr-fetch-soak 15
#          — temporarily repoints prloc slot 6 (never 0 — that's home/weather)
#            at a busy airport in a different timezone's daytime, so the soak
#            isn't gated on local busy-traffic hours. Restores the slot's
#            prior contents + original active index afterward (see the
#            python tool's --help for the one caveat: an originally-empty
#            slot can't be restored to empty, no clear-slot command exists).
#        ACTIVE_SLOT=4 ./run/pr-fetch-soak 30
#          — switches to an EXISTING, already-saved slot (e.g. a saved
#            airport) for the soak, no content overwrite at all, just the
#            active index — restored afterward. Prefer this over LOC_SLOT
#            whenever the location you want is already saved.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
MINUTES="${MINUTES:-${1:-30}}"
PORT=$(resolve_port)
LOC_ARGS=()
if [ -n "${LOC_SLOT:-}" ]; then
  LOC_ARGS=(--loc-slot "$LOC_SLOT" --lat "${LAT:?LAT required with LOC_SLOT}" \
            --lon "${LON:?LON required with LOC_SLOT}" --label "${LABEL:-TEST}")
elif [ -n "${ACTIVE_SLOT:-}" ]; then
  LOC_ARGS=(--active-slot "$ACTIVE_SLOT")
fi

# ADR-067/TASK-633: declare the build this run needs and READ THE BOARD.
# Refuses with exit 3 (RIG, `elf-mismatch`) if they differ. Runs before the
# monitor is touched, so a refused run leaves the rig as it found it.
require_build "$ENV_DEBUG" pr-fetch-soak "$PORT" || exit $?

_RC=0
_cleanup() {
  local rc=$_RC
  echo ""
  # ADR-067 D1: the production restore that used to run here is DELETED,
  # not guarded. A test entry point does not own firmware lifecycle. The
  # board keeps whatever build the last flash put there.
  echo "[pr-fetch-soak] restarting monitor"
  restart_monitor "$PORT"
  exit "$rc"
}
trap _cleanup EXIT INT TERM

echo "[pr-fetch-soak] 1/4 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

echo "[pr-fetch-soak] 2/4 — build already verified; NOT flashing (ADR-067)"
# ADR-067 D1: no flash here. require_build() above read the board and
# refused with exit 3 if it was not running the build this run needs.
# Flashing is the caller's explicit action, through run/flash*.

stamp_reset_gap "$PORT"
# TASK-563: no blind boot sleep. The post-flash reset gap is stamped above
# and enforced by lib/dut.py, which waits out the remainder on open
# (TASK-559); readiness is then decided by watching the boot the open
# itself causes, not by guessing. BOOT_WAIT never described this boot
# anyway -- TASK-561 measured 46 s to console on a NO_AP_FOUND boot
# against a BOOT_WAIT of 8.

echo "[pr-fetch-soak] 4/4 — soaking ${MINUTES} min"
(cd "$PIO_DIR" && "$VENV_PY" tools/pr_fetch_soak_report.py --port "$PORT" --minutes "$MINUTES" \
    "${LOC_ARGS[@]}") \
  || _RC=$?
