#!/usr/bin/env bash
# run/stress — unattended multi-app fetch stress/soak (TASK-248)
# Flashes the debug build, soaks every dataTask fetcher, prints a latency +
# TLS-error report, then restores production firmware + monitor. Use this to
# chase fetch reliability/latency without sitting in the manual debug loop.
#
# Usage: ./run/stress            # 10-min soak (default)
#        ./run/stress 5          # 5-min soak
#        MINUTES=20 ./run/stress
set -euo pipefail
source "$(dirname "$0")/lib.sh"
MINUTES="${MINUTES:-${1:-10}}"
PORT=$(resolve_port)

_RC=0
_cleanup() {
  local rc=$_RC
  echo ""
  echo "[stress] restoring $ENV_PROD (rc=$rc so far)"
  (cd "$PIO_DIR" && "$PIO" run -e "$ENV_PROD" -t upload --upload-port "$PORT") || {
    echo "ERROR [stress]: prod restore failed" >&2; rc=99; }
  echo "[stress] restarting monitor"
  tmux new-session -d -s "$SESSION" \
    "cd '$PIO_DIR' && '$PIO' device monitor -e '$ENV_PROD' -p '$PORT'" \
    2>/dev/null || true
  exit "$rc"
}
trap _cleanup EXIT INT TERM

echo "[stress] 1/4 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

echo "[stress] 2/4 — flashing $ENV_DEBUG to $PORT"
(cd "$PIO_DIR" && "$PIO" run -e "$ENV_DEBUG" -t upload --upload-port "$PORT")

echo "[stress] 3/4 — waiting ${BOOT_WAIT}s for boot + WiFi"
sleep "$BOOT_WAIT"

echo "[stress] 4/4 — soaking ${MINUTES} min"
(cd "$PIO_DIR" && "$VENV_PY" tools/test_fetch_stress.py --port "$PORT" --minutes "$MINUTES") \
  || _RC=$?
