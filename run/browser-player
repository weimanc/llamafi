#!/usr/bin/env bash
# run/browser-player — TASK-416 / T_PLR_13 (playback half): browse a
# ~200-file directory while a real track plays, on cyd2usb_player — the only
# env where local playback actually works (TASK-425/431: the Helix arena
# cannot be acquired on cyd2usb_winamp_debug while Spotify's ~39 KB TLS
# working set is resident, in any mount/arena ordering — measured, not
# theoretical). The browsing-only half of T_PLR_13 (walk completes, DUT stays
# responsive, no playback needed) runs on cyd2usb_winamp_debug via
# run/test-targeted T_PLR_13.
#
# NEVER kill this mid-flight — the trap-guarded prod restore races and can
# leave the DUT boot-looping (same rule as run/ae04, run/wr-soak).
#
# Usage: ./run/browser-player
set -euo pipefail
source "$(dirname "$0")/lib.sh"
ENV_PLAYER="cyd2usb_player"
PORT=$(resolve_port)

_RC=0
_cleanup() {
  local rc=$_RC
  echo ""
  echo "[browser-player] restoring $ENV_PROD (rc=$rc so far)"
  (cd "$PIO_DIR" && "$PIO" run -e "$ENV_PROD" -t upload --upload-port "$PORT") || {
    echo "ERROR [browser-player]: prod restore failed" >&2; rc=99; }
  echo "[browser-player] restarting monitor"
  restart_monitor "$PORT"
  exit "$rc"
}
trap _cleanup EXIT INT TERM

echo "[browser-player] 1/3 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

echo "[browser-player] 2/3 — flashing $ENV_PLAYER to $PORT"
(cd "$PIO_DIR" && "$PIO" run -e "$ENV_PLAYER" -t upload --upload-port "$PORT")

# DUT-measured (2026-08-11): the upload's own end-of-flash reset (via RTS) and
# the test script's serial.Serial() open (which ALSO toggles DTR/resets, per
# the CH340 driver quirk — same one BP-018/_DUT_RESET_GAP_FILE guards against
# in suite/serialdbg/runner.py's Dut class) land close enough together to trip
# the ESP32's double-reset-detector and produce a stuck, non-clean boot —
# `xTaskCreatePinnedToCore failed rc=-1` on every later play attempt, not
# self-clearing on retry. A gap here, before the port is reopened, avoids it.
echo "[browser-player] 2.5/3 — 15s gap before reopening the port (avoid DRD, BP-018-class)"
sleep 15

echo "[browser-player] 3/3 — running the browse-during-playback check"
(cd "$PIO_DIR" && "$VENV_PY" tools/test_fbrowser_player.py --port "$PORT" \
    --settle-s "${SETTLE_S:-90}") \
  || _RC=$?
