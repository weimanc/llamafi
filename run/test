#!/usr/bin/env bash
# run/test — full DUT validation loop (BP-020)
# Runs full serialdbg suite. Always restores prod firmware + monitor on exit.
# Usage: ./run/test
#        BOOT_WAIT=12 ./run/test
#        PORT=/dev/ttyUSB1 ./run/test
#        LOG_FILE=/tmp/serial.log ./run/test   (TASK-386: captures raw LOG_D/LOG_W
#          lines for the whole suite — a suite-order-dependent failure (state
#          only exists after ~150 prior tests, no reboot in between) can't be
#          diagnosed by an isolated `run/test-targeted` re-run afterward; this
#          is the only way to catch the firmware-side evidence live, in situ)
set -euo pipefail
source "$(dirname "$0")/lib.sh"
PORT=$(resolve_port)

_TEST_RC=0
_cleanup() {
  local rc=$_TEST_RC
  echo ""
  echo "[test] step 5/6 — restoring $ENV_PROD (rc=$rc so far)"
  (cd "$PIO_DIR" && "$PIO" run -e "$ENV_PROD" -t upload --upload-port "$PORT") || {
    echo "ERROR [test]: prod restore failed — DUT still running debug firmware" >&2
    rc=99
  }
  echo "[test] step 6/6 — restarting monitor"
  tmux new-session -d -s "$SESSION" \
    "cd '$PIO_DIR' && '$PIO' device monitor -e '$ENV_PROD' -p '$PORT'" \
    2>/dev/null || echo "WARN [test]: monitor start failed" >&2
  exit "$rc"
}
trap _cleanup EXIT INT TERM

# Step 0 (TASK-298 / LL-103): TLS-pin preflight, WARN-ONLY. A pinned-CA rotation
# (CoinGecko 2026-06-12 and again 2026-07-08) otherwise surfaces as a spray of
# cryptic fetch-test FAILs 30+ minutes in. FAIL lines here name the cause up
# front; ERROR lines (host can't reach a federation mirror) are expected noise.
# Never gates the run — the DUT's network vantage differs from the host's.
echo "[test] step 0/6 — TLS-pin preflight (warn-only)"
if PREFLIGHT_OUT=$("$(dirname "$0")/check-datatask-certs" 2>&1); then
  echo "$PREFLIGHT_OUT" | grep -E "^(PASS|FAIL|ERROR)" || true
else
  echo "$PREFLIGHT_OUT" | grep -E "^(PASS|FAIL|ERROR)" || true
  if echo "$PREFLIGHT_OUT" | grep -q "^FAIL"; then
    echo ""
    echo "!! [test] WARNING: pinned-CA verify FAILed for endpoint(s) above."
    echo "!!        Expect the matching fetch tests to fail on the DUT — fix"
    echo "!!        app/src/dataTaskCerts.h first (see TASK-298) unless the"
    echo "!!        failure is a known host-side artifact."
    echo ""
  fi
fi

echo "[test] step 1/6 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

echo "[test] step 2/6 — flashing $ENV_DEBUG to $PORT"
(cd "$PIO_DIR" && "$PIO" run -e "$ENV_DEBUG" -t upload --upload-port "$PORT")

echo "[test] step 3/6 — waiting ${BOOT_WAIT}s for boot + WiFi"
sleep "$BOOT_WAIT"

echo "[test] step 4/6 — running full test suite"
_LOG_ARGS=()
if [ -n "${LOG_FILE:-}" ]; then
  echo "[test] raw serial log: $LOG_FILE"
  _LOG_ARGS=(--log-file "$LOG_FILE")
fi
(cd "$PIO_DIR" && "$VENV_PY" tools/run_serialdbg_tests.py --port "$PORT" "${_LOG_ARGS[@]}") \
  || _TEST_RC=$?

# EXIT trap fires here: steps 5 and 6 run unconditionally
