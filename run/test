#!/usr/bin/env bash
# run/test — full DUT validation loop (BP-020)
# Runs full serialdbg suite. Always restores prod firmware + monitor on exit.
# Usage: ./run/test
#        BOOT_WAIT=12 ./run/test
#        PORT=/dev/ttyUSB1 ./run/test
#        LOG_FILE=/tmp/serial.log ./run/test   (TASK-386: captures raw LOG_D/LOG_W
#          lines for the whole suite — a suite-order-dependent failure (state
#          only exists after ~150 prior tests, no reboot in between) can't be
#          diagnosed by an isolated `run/test-targeted` re-run afterward; this
#          is the only way to catch the firmware-side evidence live, in situ)
set -euo pipefail
source "$(dirname "$0")/lib.sh"
PORT=$(resolve_port)

# TASK-506: snapshot persisted settings before the suite runs so they can be
# restored after — same content BP-049 already asks every DUT session to
# capture by hand (`./run/spiffs pull` + a timestamped copy), just automated
# so a run/test invocation doesn't depend on the operator remembering it.
# Best-effort throughout: a snapshot/restore failure WARNs, never fails the
# suite — the settings a test suite mutates are real but recoverable
# (BP-049's own point), not worth losing 30+ minutes of test results over.
SETTINGS_SNAPSHOT_DIR="$(mktemp -d)"
echo "[test] step 0b/6 — snapshotting settings.json (TASK-506/BP-049)"
if "$(dirname "$0")/spiffs" pull >/dev/null 2>&1 \
    && [ -f "$PIO_DIR/data/spiffs-dump/settings.json" ]; then
  cp "$PIO_DIR/data/spiffs-dump/settings.json" "$SETTINGS_SNAPSHOT_DIR/settings.json"
  echo "[test] settings.json snapshot saved to $SETTINGS_SNAPSHOT_DIR"
else
  echo "WARN [test]: settings.json snapshot failed — restore step will be skipped" >&2
  SETTINGS_SNAPSHOT_DIR=""
fi

_TEST_RC=0
_cleanup() {
  local rc=$_TEST_RC
  echo ""
  echo "[test] step 5/6 — restoring $ENV_PROD (rc=$rc so far)"
  (cd "$PIO_DIR" && "$PIO" run -e "$ENV_PROD" -t upload --upload-port "$PORT") || {
    echo "ERROR [test]: prod restore failed — DUT still running debug firmware" >&2
    rc=99
  }
  echo "[test] step 5b/6 — restoring settings.json from the pre-run snapshot (TASK-506)"
  local settings_restored=0
  if [ -n "$SETTINGS_SNAPSHOT_DIR" ] && [ -f "$SETTINGS_SNAPSHOT_DIR/settings.json" ]; then
    if SRC_FILE="$SETTINGS_SNAPSHOT_DIR/settings.json" "$(dirname "$0")/spiffs" push settings.json; then
      settings_restored=1   # `spiffs push` already restarted the monitor — step 6 below skips it
    else
      echo "WARN [test]: settings.json restore failed — device may carry test-mutated settings (BP-049: pull+diff manually)" >&2
    fi
    rm -rf "$SETTINGS_SNAPSHOT_DIR"
  else
    echo "WARN [test]: no settings.json snapshot to restore" >&2
  fi
  echo "[test] step 6/6 — restarting monitor"
  if [ "$settings_restored" = "1" ]; then
    echo "[test] monitor already restarted by the settings-restore step above — skipping"
  else
    tmux new-session -d -s "$SESSION" \
      "cd '$PIO_DIR' && '$PIO' device monitor -e '$ENV_PROD' -p '$PORT'" \
      2>/dev/null || echo "WARN [test]: monitor start failed" >&2
  fi
  # TASK-434 item 1: the harness exits SETUP_FAIL_EXIT (3) for a RIG condition —
  # WiFi never came up, wrong firmware flashed, port busy. Re-state it AFTER the
  # prod restore, because the restore's flash output is the last thing in the log
  # and a reader who greps for PASS/FAIL finds neither. Note rc is deliberately
  # read after the restore block: a restore failure overwrites it with 99, and in
  # that case this line is the only surviving evidence that no tests ever ran.
  if [ "$rc" = "3" ] || [ "$_TEST_RC" = "3" ]; then
    echo ""
    echo "[SETUP-FAIL] rig condition — NO TESTS RAN. This is not a test failure."
    echo "             See the [SETUP-FAIL] block and serial tail above the restore output."
  fi
  exit "$rc"
}
trap _cleanup EXIT INT TERM

# Step 0 (TASK-298 / LL-103): TLS-pin preflight, WARN-ONLY. A pinned-CA rotation
# (CoinGecko 2026-06-12 and again 2026-07-08) otherwise surfaces as a spray of
# cryptic fetch-test FAILs 30+ minutes in. FAIL lines here name the cause up
# front; ERROR lines (host can't reach a federation mirror) are expected noise.
# Never gates the run — the DUT's network vantage differs from the host's.
echo "[test] step 0/6 — TLS-pin preflight (warn-only)"
if PREFLIGHT_OUT=$("$(dirname "$0")/check-datatask-certs" 2>&1); then
  echo "$PREFLIGHT_OUT" | grep -E "^(PASS|FAIL|ERROR)" || true
else
  echo "$PREFLIGHT_OUT" | grep -E "^(PASS|FAIL|ERROR)" || true
  if echo "$PREFLIGHT_OUT" | grep -q "^FAIL"; then
    echo ""
    echo "!! [test] WARNING: pinned-CA verify FAILed for endpoint(s) above."
    echo "!!        Expect the matching fetch tests to fail on the DUT — fix"
    echo "!!        app/src/dataTaskCerts.h first (see TASK-298) unless the"
    echo "!!        failure is a known host-side artifact."
    echo ""
  fi
fi

echo "[test] step 1/6 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

echo "[test] step 2/6 — flashing $ENV_DEBUG to $PORT"
(cd "$PIO_DIR" && "$PIO" run -e "$ENV_DEBUG" -t upload --upload-port "$PORT")

echo "[test] step 3/6 — waiting ${BOOT_WAIT}s for boot + WiFi"
sleep "$BOOT_WAIT"

echo "[test] step 4/6 — running full test suite"
_LOG_ARGS=()
if [ -n "${LOG_FILE:-}" ]; then
  echo "[test] raw serial log: $LOG_FILE"
  _LOG_ARGS=(--log-file "$LOG_FILE")
fi
(cd "$PIO_DIR" && "$VENV_PY" tools/run_serialdbg_tests.py --port "$PORT" "${_LOG_ARGS[@]}") \
  || _TEST_RC=$?

# EXIT trap fires here: steps 5 and 6 run unconditionally
