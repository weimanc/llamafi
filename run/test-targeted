#!/usr/bin/env bash
# run/test-targeted — targeted DUT validation loop (BP-021)
# Usage: ./run/test-targeted T080,T083,T091
#        TESTS=T080,T083 ./run/test-targeted
#        ./run/test-targeted --scope LocalPlayer          (TASK-570: every id
#          attributed to that app -- no test_plan.md lookup, no id list)
#        ./run/test-targeted --scope app/src/apps/clockApp.cpp   (the file you
#          changed; it resolves to the app, then to the app's ids)
#        SCOPE=taskbar ./run/test-targeted                (env form)
#        SCOPE=Stock ./run/test-targeted T169,T170        (both: intersection)
#        BOOT_WAIT=12 ./run/test-targeted T-SET-01,T-SET-02
#        LOG_FILE=/tmp/serial.log ./run/test-targeted T188,T192   (captures raw
#          LOG_D/LOG_W lines alongside dbg command output, for diagnosing
#          failures whose cause isn't visible in dbg output alone)
set -euo pipefail
source "$(dirname "$0")/lib.sh"
SCOPE="${SCOPE:-}"
if [ "${1:-}" = "--scope" ]; then
  SCOPE="${2:-}"
  [ -n "$SCOPE" ] || { echo "Usage: $0 --scope <app|scope|path>" >&2; exit 1; }
  shift 2
fi
TESTS="${TESTS:-${1:-}}"
[ -n "$TESTS" ] || [ -n "$SCOPE" ] || {
  echo "Usage: $0 T080,T083  OR  TESTS=T080,T083 $0  OR  $0 --scope <app|path>" >&2
  exit 1
}
_PORT_EXPLICIT="${PORT:-}"
PORT=$(resolve_port)

# ADR-067/TASK-633: declare the build, do not flash it. require_build stops the
# monitor for the duration of its port open and restarts it if it refuses
# (TASK-661/D-1b), so a wrong-build run still leaves the rig exactly as it found
# it — and a right-build run finds the monitor already down at step 1.
require_build "$ENV_DEBUG" test-targeted "$PORT" || exit $?

_TEST_RC=0
_cleanup() {
  local rc=$_TEST_RC
  local pt; pt=$(restore_port "$PORT" "$_PORT_EXPLICIT")
  echo ""
  echo "[test-targeted] step 3/3 — restarting monitor (rc=$rc; nothing restored — ADR-067)"
  restart_monitor "$pt"
  # TASK-434 item 1: the harness exits 3 for a RIG condition and 4 for a HEALTH
  # one. Re-stated last, because a reader greps the tail for PASS/FAIL and finds
  # neither.
  explain_exit_code "$rc" test-targeted
  rigwatch_stamp run-end who=test-targeted rc="$rc"
  exit "$rc"
}
trap _cleanup EXIT INT TERM
rigwatch_stamp run-begin who=test-targeted

echo "[test-targeted] running: ${TESTS:-<scope ${SCOPE}>}"

echo "[test-targeted] step 1/3 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

# No flash step. The board's build identity is verified on the port the runner
# opens below (lib/dut.py::_verify_debug_firmware), which costs no extra open
# and therefore no extra DTR reset — see run/lib.sh's ADR-067 block.
#
# TASK-563: no blind boot sleep either. Readiness is decided by watching the
# boot the open itself causes, not by guessing. BOOT_WAIT never described that
# boot anyway — TASK-561 measured 46 s to console on a NO_AP_FOUND boot against
# a BOOT_WAIT of 8.

echo "[test-targeted] step 2/3 — running tests: ${TESTS:-<scope ${SCOPE}>}"
_LOG_ARGS=()
if [ -n "${LOG_FILE:-}" ]; then
  echo "[test-targeted] raw serial log: $LOG_FILE"
  _LOG_ARGS=(--log-file "$LOG_FILE")
fi
# NO_WIFI=1 ./run/test-targeted T_PLR_08,... — for suites that touch no network
# (the SD-backed player tests). Off by default: a WiFi failure must stay a real
# failure for everything else.
_WIFI_ARGS=()
[ "${NO_WIFI:-}" = "1" ] && _WIFI_ARGS+=(--no-wifi)
# TASK-570: --tests and --scope are both optional and compose (the runner
# intersects them). Passing an empty --tests would select nothing, so the flag
# is omitted entirely when only a scope was given.
_SEL_ARGS=()
[ -n "$TESTS" ] && _SEL_ARGS+=(--tests "$TESTS")
[ -n "$SCOPE" ] && _SEL_ARGS+=(--scope "$SCOPE")
# TASK-671: per-test transcripts for the replay-driven can-go-red gate.
_RECORD_ARGS=()
if [ -n "${RECORD_DIR:-}" ]; then
  _RECORD_ARGS=(--record "$(realpath -m "$RECORD_DIR")")
fi
_RUNNER_OUT="$(mktemp)"
(cd "$PIO_DIR" && "$VENV_PY" tools/suite/serialdbg/runner.py --port "$PORT" "${_SEL_ARGS[@]}" "${_LOG_ARGS[@]}" "${_WIFI_ARGS[@]}" "${_RECORD_ARGS[@]}" | tee "$_RUNNER_OUT") \
  || _TEST_RC=$?

# TASK-689: REPORT ONLY, never a gate — see run/test's copy of this comment
# for the full reasoning. Diffs this run's artifact against the most recent
# COMPARABLE prior one (same entry_point + build_env + board) and prints the
# delta; a targeted run's smaller id set vs a full run's is expected and is
# called out by lib.artifact.format_diff, not misread as a mass regression.
# Never touches $_TEST_RC.
_ARTIFACT_PATH=$(grep -oE '^\[artifact\] [^[:space:]]+' "$_RUNNER_OUT" | tail -1 | awk '{print $2}')
if [ -n "$_ARTIFACT_PATH" ]; then
  echo ""
  ( cd "$PIO_DIR/tools" && "$VENV_PY" -m lib.artifact "$_ARTIFACT_PATH" --diff-auto ) || true
fi
rm -f "$_RUNNER_OUT"
