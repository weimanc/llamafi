#!/usr/bin/env bash
# run/test-targeted — targeted DUT validation loop (BP-021)
# Usage: ./run/test-targeted T080,T083,T091
#        TESTS=T080,T083 ./run/test-targeted
#        BOOT_WAIT=12 ./run/test-targeted T-SET-01,T-SET-02
#        LOG_FILE=/tmp/serial.log ./run/test-targeted T188,T192   (captures raw
#          LOG_D/LOG_W lines alongside dbg command output, for diagnosing
#          failures whose cause isn't visible in dbg output alone)
set -euo pipefail
source "$(dirname "$0")/lib.sh"
TESTS="${TESTS:-${1:-}}"
[ -n "$TESTS" ] || {
  echo "Usage: $0 T080,T083  OR  TESTS=T080,T083 $0" >&2
  exit 1
}
PORT=$(resolve_port)

_TEST_RC=0
_cleanup() {
  local rc=$_TEST_RC
  echo ""
  echo "[test-targeted] step 5/6 — restoring $ENV_PROD (rc=$rc so far)"
  (cd "$PIO_DIR" && "$PIO" run -e "$ENV_PROD" -t upload --upload-port "$PORT") || {
    echo "ERROR [test-targeted]: prod restore failed" >&2
    rc=99
  }
  echo "[test-targeted] step 6/6 — restarting monitor"
  tmux new-session -d -s "$SESSION" \
    "cd '$PIO_DIR' && '$PIO' device monitor -e '$ENV_PROD' -p '$PORT'" \
    2>/dev/null || true
  # TASK-434 item 1: the harness exits SETUP_FAIL_EXIT (3) for a RIG condition —
  # WiFi never came up, wrong firmware flashed, port busy. Re-state it AFTER the
  # prod restore, because the restore's flash output is the last thing in the log
  # and a reader who greps for PASS/FAIL finds neither. Note rc is deliberately
  # read after the restore block: a restore failure overwrites it with 99, and in
  # that case this line is the only surviving evidence that no tests ever ran.
  if [ "$rc" = "3" ] || [ "$_TEST_RC" = "3" ]; then
    echo ""
    echo "[SETUP-FAIL] rig condition — NO TESTS RAN. This is not a test failure."
    echo "             See the [SETUP-FAIL] block and serial tail above the restore output."
  fi
  exit "$rc"
}
trap _cleanup EXIT INT TERM

echo "[test-targeted] running: $TESTS"

echo "[test-targeted] step 1/6 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

echo "[test-targeted] step 2/6 — flashing $ENV_DEBUG to $PORT"
(cd "$PIO_DIR" && "$PIO" run -e "$ENV_DEBUG" -t upload --upload-port "$PORT")

echo "[test-targeted] step 3/6 — waiting ${BOOT_WAIT}s for boot + WiFi"
sleep "$BOOT_WAIT"

echo "[test-targeted] step 4/6 — running tests: $TESTS"
_LOG_ARGS=()
if [ -n "${LOG_FILE:-}" ]; then
  echo "[test-targeted] raw serial log: $LOG_FILE"
  _LOG_ARGS=(--log-file "$LOG_FILE")
fi
# NO_WIFI=1 ./run/test-targeted T_PLR_08,... — for suites that touch no network
# (the SD-backed player tests). Off by default: a WiFi failure must stay a real
# failure for everything else.
_WIFI_ARGS=()
[ "${NO_WIFI:-}" = "1" ] && _WIFI_ARGS+=(--no-wifi)
(cd "$PIO_DIR" && "$VENV_PY" tools/run_serialdbg_tests.py --port "$PORT" --tests "$TESTS" "${_LOG_ARGS[@]}" "${_WIFI_ARGS[@]}") \
  || _TEST_RC=$?
