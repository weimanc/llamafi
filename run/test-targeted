#!/usr/bin/env bash
# run/test-targeted — targeted DUT validation loop (BP-021)
# Usage: ./run/test-targeted T080,T083,T091
#        TESTS=T080,T083 ./run/test-targeted
#        ./run/test-targeted --scope LocalPlayer          (TASK-570: every id
#          attributed to that app -- no test_plan.md lookup, no id list)
#        ./run/test-targeted --scope app/src/apps/clockApp.cpp   (the file you
#          changed; it resolves to the app, then to the app's ids)
#        SCOPE=taskbar ./run/test-targeted                (env form)
#        SCOPE=Stock ./run/test-targeted T169,T170        (both: intersection)
#        BOOT_WAIT=12 ./run/test-targeted T-SET-01,T-SET-02
#        LOG_FILE=/tmp/serial.log ./run/test-targeted T188,T192   (captures raw
#          LOG_D/LOG_W lines alongside dbg command output, for diagnosing
#          failures whose cause isn't visible in dbg output alone)
set -euo pipefail
source "$(dirname "$0")/lib.sh"
SCOPE="${SCOPE:-}"
if [ "${1:-}" = "--scope" ]; then
  SCOPE="${2:-}"
  [ -n "$SCOPE" ] || { echo "Usage: $0 --scope <app|scope|path>" >&2; exit 1; }
  shift 2
fi
TESTS="${TESTS:-${1:-}}"
[ -n "$TESTS" ] || [ -n "$SCOPE" ] || {
  echo "Usage: $0 T080,T083  OR  TESTS=T080,T083 $0  OR  $0 --scope <app|path>" >&2
  exit 1
}
_PORT_EXPLICIT="${PORT:-}"
PORT=$(resolve_port)

_TEST_RC=0
_cleanup() {
  local rc=$_TEST_RC
  local restore_pt; restore_pt=$(restore_port "$PORT" "$_PORT_EXPLICIT")
  echo ""
  echo "[test-targeted] step 5/6 — restoring $ENV_PROD (rc=$rc so far)"
  (cd "$PIO_DIR" && "$PIO" run -e "$ENV_PROD" -t upload --upload-port "$restore_pt") || {
    echo "ERROR [test-targeted]: prod restore failed" >&2
    rc=99
  }
  echo "[test-targeted] step 6/6 — restarting monitor"
  restart_monitor "$restore_pt"
  # TASK-434 item 1: the harness exits SETUP_FAIL_EXIT (3) for a RIG condition —
  # WiFi never came up, wrong firmware flashed, port busy. Re-state it AFTER the
  # prod restore, because the restore's flash output is the last thing in the log
  # and a reader who greps for PASS/FAIL finds neither. Note rc is deliberately
  # read after the restore block: a restore failure overwrites it with 99, and in
  # that case this line is the only surviving evidence that no tests ever ran.
  if [ "$rc" = "3" ] || [ "$_TEST_RC" = "3" ]; then
    echo ""
    echo "[SETUP-FAIL] rig condition — NO TESTS RAN. This is not a test failure."
    echo "             See the [SETUP-FAIL] block and serial tail above the restore output."
  fi
  # TASK-566 / EC-G7: exit 4 is NEW and is NOT exit 3. Untaught, a HEALTH
  # failure falls through here and reads as a completed run — the exact
  # inversion M-TESTARCH exists to prevent, and it already happened once
  # for FLAKY-PASS (TASK-573).
  if [ "$rc" = "4" ] || [ "$_TEST_RC" = "4" ]; then
    echo ""
    echo "[HEALTH-FAIL] the BOARD was not a valid test subject — NO TESTS RAN."
    echo "             This is NOT a rig condition and NOT a test failure. The"
    echo "             board is running and it answered; it is not fit to be a"
    echo "             subject. Do not blame the cable, the port or the host."
    echo "             Diagnose the DEVICE: ./run/monitor-read for the boot above,"
    echo "             and the last-phase=/gen= stamps in the [SETUP-FAIL] block."
    echo "             (M-TESTARCH §4: exit 3 = the host could not address a"
    echo "             board; exit 4 = the board is not a valid subject.)"
  fi
  exit "$rc"
}
trap _cleanup EXIT INT TERM

echo "[test-targeted] running: ${TESTS:-<scope ${SCOPE}>}"

echo "[test-targeted] step 1/6 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

echo "[test-targeted] step 2/6 — flashing $ENV_DEBUG to $PORT"
(cd "$PIO_DIR" && "$PIO" run -e "$ENV_DEBUG" -t upload --upload-port "$PORT")
# TASK-559: esptool just hard-reset the DUT. Record it where lib/dut.py's
# DRD guard can see it, so the harness open below waits out the remainder of
# the window instead of landing inside it (BOOT_WAIT=8 < _DUT_DRD_WINDOW_S=12).
stamp_reset_gap "$PORT"


# TASK-563: no blind boot sleep. The post-flash reset gap is stamped above
# and enforced by lib/dut.py, which waits out the remainder on open
# (TASK-559); readiness is then decided by watching the boot the open
# itself causes, not by guessing. BOOT_WAIT never described this boot
# anyway -- TASK-561 measured 46 s to console on a NO_AP_FOUND boot
# against a BOOT_WAIT of 8.

echo "[test-targeted] step 4/6 — running tests: ${TESTS:-<scope ${SCOPE}>}"
_LOG_ARGS=()
if [ -n "${LOG_FILE:-}" ]; then
  echo "[test-targeted] raw serial log: $LOG_FILE"
  _LOG_ARGS=(--log-file "$LOG_FILE")
fi
# NO_WIFI=1 ./run/test-targeted T_PLR_08,... — for suites that touch no network
# (the SD-backed player tests). Off by default: a WiFi failure must stay a real
# failure for everything else.
_WIFI_ARGS=()
[ "${NO_WIFI:-}" = "1" ] && _WIFI_ARGS+=(--no-wifi)
# TASK-570: --tests and --scope are both optional and compose (the runner
# intersects them). Passing an empty --tests would select nothing, so the flag
# is omitted entirely when only a scope was given.
_SEL_ARGS=()
[ -n "$TESTS" ] && _SEL_ARGS+=(--tests "$TESTS")
[ -n "$SCOPE" ] && _SEL_ARGS+=(--scope "$SCOPE")
(cd "$PIO_DIR" && "$VENV_PY" tools/suite/serialdbg/runner.py --port "$PORT" "${_SEL_ARGS[@]}" "${_LOG_ARGS[@]}" "${_WIFI_ARGS[@]}") \
  || _TEST_RC=$?
