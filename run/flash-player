#!/usr/bin/env bash
# run/flash-player — flash cyd2usb_player (TASK-427/431: Player-mode dedicated variant,
# SD_BOOT_MOUNT + DISABLE_SPOTIFY). Mirrors run/flash-webradio's structure/precedent.
# Monitor is NOT restarted so the test harness can attach.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
PORT=$(resolve_port)
cert_preflight

echo "[flash-player] 1/2 — killing monitor"
tmux kill-session -t "$SESSION" 2>/dev/null && sleep 1 || true

echo "[flash-player] 2/2 — flashing cyd2usb_player to $PORT"
(cd "$PIO_DIR" && "$PIO" run -e cyd2usb_player -t upload --upload-port "$PORT")
echo "[flash-player] done (monitor NOT restarted — port free for test harness)"
