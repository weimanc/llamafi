[ "$LEG_A_TESTS" = "$_DEFAULT_A" ] || _PARTIAL="yes"
[ "$LEG_B_TESTS" = "$_DEFAULT_B" ] || _PARTIAL="yes"
[ "$SKIP_SCRIPTS" = "1" ] && _PARTIAL="yes"
