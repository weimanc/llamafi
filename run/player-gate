#!/usr/bin/env bash
# run/player-gate — M-TESTBASE phase-1 player gate (TASK-519), ONE runnable script.
#
# The gate is ONE ORDERED EXECUTION OF TWO LEGS AT THE SAME COMMIT
# (M-TESTBASE-phase1-player-gate.md §4 P3, VE's wording):
#
#   Leg A  cyd2usb_winamp_debug : T_PLR_01-24,26 + M3/M4a/M5 + the S->W and W->L cells
#   Leg B  cyd2usb_player       : test_fbrowser_player.py, test_playorder_player.py,
#                                 the L->S cell and the M2 cells
#
# It FAILS if any cell in either leg regresses against the pre-declared pass set at
# docs/verification/regression_suite/player-gate-baseline.md — which is a file of
# IDS, not a count (§3.4 item 3: "'>=3 runs' without the identity of what passed is
# the exact failure TASK-488 hit").
#
# Condition (a) of §4 is ENFORCED, not documented: a leg whose id list contains no
# cross-mode cell (T_PMT_01-04) is refused with exit 2, because without one the leg
# is two per-mode suites concatenated and the gate's objective is lost.
# Condition (b): the two-build drive follows run/task488's DUT_TREE shape — one
# script, one trap, per-leg DUT_ENV so each leg's ELF-hash guard checks the binary
# that is actually on the device. Since ADR-067 that guard is the WHOLE mechanism:
# the gate reads the board and refuses (exit 3) rather than flashing the leg build.
#
# NEVER kill this mid-flight (timeout / Ctrl-C / host suspend). It no longer races
# a restore (ADR-067 deleted it), but it still races an in-flight measurement, and
# host suspend resets the USB device under it. Budget ~45 min for a full two-leg
# run: 4 boots, 2 x 90 s settle. NOTE both leg builds must ALREADY be on the board
# in turn: the gate verifies and refuses (exit 3), it does not flash.
#
# Usage
#   ./run/player-gate                        # full gate, both legs
#   LEGS=A ./run/player-gate                 # leg A only (PARTIAL verdict)
#   LEGS=B SKIP_SCRIPTS=1 ./run/player-gate  # leg B runner cells only, no playback scripts
#   LEG_A_TESTS=T_PMT_00,T_PMT_01 ./run/player-gate   # validation-sized id set
#   RECORD=1 ./run/player-gate               # also emit the observed table for re-declaring
#   ./run/player-gate --selftest             # host-only negative tests of the comparator (BP-068)
#
# Env
#   PORT           serial port override (default: CH340 by VID:PID via run/port)
#   LEGS           comma list of legs to run                      (default A,B)
#   LEG_A_TESTS    override leg A's runner id list                (default: full leg A set)
#   LEG_B_TESTS    override leg B's runner id list                (default T_PMT_00,03,04)
#   SKIP_SCRIPTS   1 = skip leg B's two standalone playback scripts
#   SKIP_FLASH     REMOVED (ADR-067/TASK-633). This gate never flashes now, so
#                  there is nothing to skip. Setting it does nothing; it is
#                  refused loudly rather than ignored, because a caller who sets
#                  it believes something about this script that is no longer true.
#   BASELINE       path to the pass-set markdown            (default: the doc above)
#   OUT_DIR        artifact dir                             (default: mktemp -d)
#   RECORD         1 = write $OUT_DIR/observed.md
#   SETTLE_S       settle for the leg-B playback scripts           (default 90)
#   BOOT_WAIT      post-flash wait before the runner opens the port (default 8, lib.sh)
#   ALLOW_NO_CROSSMODE  1 = waive condition (a). Validation runs only; it makes the
#                  run NOT a gate run and the summary says so.
#
# Exit codes
#   0   every declared cell in every leg that ran met the pass set
#   1   REGRESSION — a declared cell failed, went missing, or a new cell failed
#   2   usage / configuration error (bad leg, unreadable baseline, condition (a) unmet)
#   3   RIG condition — a leg exited SETUP_FAIL_EXIT; NO VERDICT, no tests ran
#   4   HEALTH condition — a leg exited HEALTH_FAIL_EXIT; NO VERDICT. The board
#       was running and answered, and was not a valid test SUBJECT. Distinct
#       from 3 on purpose (M-TESTARCH §4): 3 = the host could not address a
#       board, 4 = the board is not a valid subject. Also emitted when
#       DUT_HEALTH=warn|skip downgraded the premise (@VE ruling §18.2) — a gate
#       run whose health premise was downgraded is not a gate run.
#   (99 is retired: it meant "production restore FAILED", and ADR-067/TASK-633
#    deleted the restore. Nothing emits it.)
#
# On every exit path including failure and interrupt: restart the tmux serial
# monitor. NOT a firmware restore — the board keeps the leg build it ends on.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

ENV_LEG_A="cyd2usb_winamp_debug"
ENV_LEG_B="cyd2usb_player"

BASELINE="${BASELINE:-$PROJ_ROOT/docs/verification/regression_suite/player-gate-baseline.md}"
LEGS="${LEGS:-A,B}"
SETTLE_S="${SETTLE_S:-90}"
SKIP_SCRIPTS="${SKIP_SCRIPTS:-0}"
if [ -n "${SKIP_FLASH:-}" ]; then
  echo "ERROR [player-gate]: SKIP_FLASH is gone (ADR-067/TASK-633). This gate" >&2
  echo "  no longer flashes anything, so there is nothing to skip — it VERIFIES" >&2
  echo "  the board and refuses with exit 3 if the build is wrong. Flash the leg" >&2
  echo "  build yourself first: ./run/flash-player or ./run/flash-debug." >&2
  exit 2
fi
RECORD="${RECORD:-0}"
ALLOW_NO_CROSSMODE="${ALLOW_NO_CROSSMODE:-0}"

# The default leg id lists. Leg A is T_PLR_01-24 and 26 (25 is the real-decode cell
# and lives on leg B as T_PLR_25_playback), plus the binding cell and the two leg-A
# edges. M3 = T_PLR_17/18/19, M4a = T_PLR_20-24/26, M5 is asserted inside the
# `get player` vector every T_PMT_0x cell reads — all already in this list.
_DEFAULT_A="T_PLR_01,T_PLR_02,T_PLR_03,T_PLR_04,T_PLR_05,T_PLR_06,T_PLR_07,T_PLR_08,\
T_PLR_09,T_PLR_10,T_PLR_11,T_PLR_12,T_PLR_13,T_PLR_14,T_PLR_15,T_PLR_16,T_PLR_17,\
T_PLR_18,T_PLR_19,T_PLR_20,T_PLR_21,T_PLR_22,T_PLR_23,T_PLR_24,T_PLR_26,\
T_PMT_00,T_PMT_01,T_PMT_02"
_DEFAULT_B="T_PMT_00,T_PMT_03,T_PMT_04"

LEG_A_TESTS="${LEG_A_TESTS:-$_DEFAULT_A}"
LEG_B_TESTS="${LEG_B_TESTS:-$_DEFAULT_B}"

# The cross-mode cells — the ones that assert on mode X after ARRIVING FROM mode Y.
# Condition (a) is checked against this list.
_CROSSMODE="T_PMT_01 T_PMT_02 T_PMT_03 T_PMT_04"

SETUP_FAIL_EXIT=3
# TASK-566 / EC-G7. Before this, an exit-4 leg fell through `rc == $SETUP_FAIL_EXIT`
# and was treated as a COMPLETED leg: every declared cell would have scored
# MISSING and the gate would have printed REGRESS for a firmware regression that
# never happened. That is not hypothetical — it is precisely what TASK-573 fixed
# for `FLAKY-PASS`, on a token that shipped years before NOT-RUN was proposed.
HEALTH_FAIL_EXIT=4

# @VE ruling, binding (M-TESTARCH §18.2): a gate run whose HEALTH premise was
# DOWNGRADED is not a gate run. Same shape as the SETUP_FAIL refusal and the
# ALLOW_NO_CROSSMODE banner — refuse, say why, emit no PASS/REGRESS verdict.
# Ahead of the trap for the same reason condition (a) is: a configuration
# refusal must not trigger a full production reflash.
_assert_health_premise() {
  case "${DUT_HEALTH:-gate}" in
    ""|gate) return 0 ;;
    warn|skip)
      echo "ERROR [player-gate]: DUT_HEALTH=$DUT_HEALTH — refusing to run." >&2
      echo "  A gate run whose health premise was downgraded is NOT a gate run:" >&2
      echo "  it cannot emit PASS or REGRESS, because it cannot say the board was" >&2
      echo "  a valid subject (@VE ruling, M-TESTARCH §18.2)." >&2
      echo "  Use ./run/dut-health to diagnose the board, or unset DUT_HEALTH." >&2
      exit 2 ;;
    *)
      echo "ERROR [player-gate]: DUT_HEALTH must be gate|warn|skip (got '$DUT_HEALTH')" >&2
      exit 2 ;;
  esac
}

# ── pure functions (no DUT) — also exercised by --selftest ───────────────────

# Emit "leg<TAB>id<TAB>expected" for every adjudicated row of the pass set.
# Positional markdown columns: | leg | id | expected | note |. A row whose
# expected column is neither PASS nor SKIP is INVISIBLE on purpose: an
# un-adjudicated row must not silently weaken the gate.
_baseline_rows() {
  awk -F'|' '
    /^[[:space:]]*\|/ {
      # NB: not `exp` — that is an awk builtin and using it as a variable is a
      # syntax error the parser reports per input line. Caught by --selftest,
      # which is the only reason it was not a silently empty pass set.
      leg=$2; id=$3; want=$4
      gsub(/[[:space:]`*]/, "", leg); gsub(/[[:space:]`*]/, "", id)
      gsub(/[[:space:]`*]/, "", want)
      if ((leg=="A" || leg=="B") && id ~ /^T_/ && (want=="PASS" || want=="SKIP"))
        print leg"\t"id"\t"want
    }' "$1"
}

# Extract "id status" from the run's ARTIFACT — never from the printed summary.
#
# TASK-608 / ADR-066 D1 / IFC-008 I6. This function used to be a sed regex over
# `lib/results.py`'s human summary, and that arrangement produced a live false
# verdict: results.py wrote `FLAKY-PASS`, the alternation carried `FLAKE`,
# `FLAKE` != `FLAKY`, the line was dropped, the cell scored MISSING and this gate
# printed REGRESS for a firmware regression that never happened (TASK-573). The
# summary has no schema and had three parsers; a format like that is not
# tightenable, so it stopped being the interface. It is still printed, for
# humans, and nothing here reads it.
#
# STALENESS IS THE FAILURE THIS IS DESIGNED AGAINST. A gate scoring a leg against
# a PREVIOUS run's artifact is worse than a gate with no artifact at all — it is
# silent and it looks like a result. Three layers, and this function is layer 2:
# the leg mints a nonce, exports it, and the reader REFUSES (exit 2) any document
# carrying a different one. Layers 1 and 3 are in lib/artifact.py.
#
# $1 = artifact path, $2 = the nonce that leg was run with.
_read_artifact() {
  ( cd "$PIO_DIR/tools" && "$VENV_PY" -m lib.artifact "$1" --token "$2" --ids-status )
}

# Compare one leg. $1=leg $2=file of ids that RAN $3=file of "id status" observed.
# Prints one verdict line per cell; returns 1 if the leg regressed.
_compare_leg() {
  local leg="$1" ran="$2" obs="$3"
  local rc=0 id exp got line
  # declared cells for this leg, restricted to the ids that actually ran
  while IFS=$'\t' read -r rleg id exp; do
    [ "$rleg" = "$leg" ] || continue
    grep -qxF "$id" "$ran" || continue
    got="$(awk -v i="$id" '$1==i{print $2; exit}' "$obs")"
    [ -n "$got" ] || got="MISSING"
    case "$exp:$got" in
      PASS:PASS|SKIP:SKIP)
        echo "    ok        $leg $id  $got (declared $exp)" ;;
      SKIP:PASS)
        echo "    improved  $leg $id  PASS where SKIP was declared — re-declare the row" ;;
      PASS:FLAKY-PASS|SKIP:FLAKY-PASS)
        # TASK-573: a declared flake that passed on its MANDATED retry gets its own
        # outcome — visible, and non-fatal. lib/results.py's bucket-4 policy already
        # reports FLAKY-PASS separately and does NOT count it as a pass, and
        # docs/verification/flaky.yaml tracks each one with an owner and a review_by.
        # Scoring it PASS would launder a flake into the pass set; scoring it REGRESS
        # would call a passing test a firmware regression (which is exactly the bug
        # this replaces). So: neither. Reported, not counted, rc unchanged.
        echo "    flaky     $leg $id  FLAKY-PASS (declared $exp) — passed on its mandated retry; NOT counted as a pass" ;;
      *:NOT-RUN)
        # A declared cell that never ran means the gate verified nothing for it.
        # That must never read green. (NOT-RUN arrives with TASK-566; inert today.)
        echo "    NOT-RUN   $leg $id  declared $exp but never ran — the gate verified nothing for this cell"
        rc=1 ;;
      *:UNMET)
        # TASK-624 / ADR-066 D4 + R38. The cell RAN and asserted nothing: its own
        # premise never held. Fatal, and labelled distinctly from NOT-RUN on
        # purpose — a NOT-RUN names the class failure that blocked it, an UNMET
        # usually has nothing to blame, and the reader needs to know which they
        # are looking at. rc=1, never a new exit code (§4.1).
        echo "    UNMET     $leg $id  declared $exp but its premise was never established — the gate verified nothing for this cell"
        rc=1 ;;
      *)
        echo "    REGRESS   $leg $id  observed $got, declared $exp"
        rc=1 ;;
    esac
  done < <(_baseline_rows "$BASELINE")

  # A cell that failed but was never declared is still a failure. A cell that
  # passed and was never declared is only bookkeeping drift.
  while read -r id got; do
    grep -qxF "$id" "$ran" || continue
    if _baseline_rows "$BASELINE" | awk -v l="$leg" -v i="$id" \
         '$1==l && $2==i {found=1} END{exit !found}'; then continue; fi
    case "$got" in
      PASS) echo "    unbaselined $leg $id  PASS — not in the pass set" ;;
      SKIP) echo "    unbaselined $leg $id  SKIP — not in the pass set" ;;
      # TASK-573: same reasoning as the declared branch — a declared flake that
      # passed on its retry is not a failure, so out here it is bookkeeping drift
      # like PASS/SKIP, not a regression.
      FLAKY-PASS) echo "    unbaselined $leg $id  FLAKY-PASS — not in the pass set; passed on its mandated retry, NOT counted as a pass" ;;
      # TASK-624: an undeclared cell whose premise never held asserted nothing.
      # It is not drift like PASS/SKIP — it is a cell with no verdict at all.
      UNMET) echo "    UNMET     $leg $id  premise never established — not in the pass set, and it verified nothing"; rc=1 ;;
      *)    echo "    REGRESS   $leg $id  observed $got, not in the pass set"; rc=1 ;;
    esac
  done < "$obs"
  return $rc
}

# Condition (a), M-TESTBASE §4: enforced, not documented.
_assert_crossmode() {
  local leg="$1" ids="$2" c
  for c in $_CROSSMODE; do
    case ",$ids," in *,"$c",*) return 0 ;; esac
  done
  if [ "$ALLOW_NO_CROSSMODE" = "1" ]; then
    echo "!! [player-gate] leg $leg has NO cross-mode cell — waived by ALLOW_NO_CROSSMODE=1."
    echo "!!   This run is NOT a gate run: without a cell asserting on mode X after"
    echo "!!   arriving from mode Y the leg is a per-mode suite (M-TESTBASE §4 (a))."
    return 0
  fi
  echo "ERROR [player-gate]: leg $leg id list has no cross-mode cell." >&2
  echo "  M-TESTBASE §4 (a): each leg must contain at least one cell asserting on" >&2
  echo "  mode X after arriving from mode Y, else it is two per-mode suites" >&2
  echo "  concatenated and the objective is lost. Cross-mode cells: $_CROSSMODE" >&2
  echo "  Set ALLOW_NO_CROSSMODE=1 for a validation run that is explicitly not a gate." >&2
  exit 2
}

# ── --selftest: the gate's own negative tests (BP-068) ───────────────────────
# A gate ships with tests that break it the way it is meant to catch. These run
# the real comparator against synthetic observations — no DUT, no flash.
_selftest() {
  local tmp; tmp="$(mktemp -d)"; trap "rm -rf '$tmp'" RETURN
  local fails=0 out rc
  cat >"$tmp/base.md" <<'EOF'
| leg | id | expected | note |
|---|---|---|---|
| A | T_PMT_00 | PASS | binding |
| A | T_PMT_01 | PASS | cross-mode |
| A | T_PLR_09 | SKIP | declared skip |
| B | T_PMT_04 | PASS | arena |
| A | T_PLR_99 | resv | un-adjudicated: must be invisible |
EOF
  BASELINE="$tmp/base.md"
  printf 'T_PMT_00\nT_PMT_01\nT_PLR_09\n' >"$tmp/ran"

  _case() { # name expect_rc observed...
    local name="$1" want="$2"; shift 2
    : >"$tmp/obs"; printf '%s\n' "$@" >"$tmp/obs"
    set +e; out="$(_compare_leg A "$tmp/ran" "$tmp/obs")"; rc=$?; set -e
    if [ "$rc" = "$want" ]; then
      echo "  [PASS] selftest $name (rc=$rc)"
    else
      echo "  [FAIL] selftest $name — rc=$rc want=$want"; echo "$out" | sed 's/^/         /'
      fails=$((fails+1))
    fi
  }

  # Like _case, but ALSO asserts the verdict text contains a required substring —
  # for outcomes whose whole point is that they are visible and correctly labelled.
  _case_line() { # name expect_rc required_substring observed...
    local name="$1" want="$2" needle="$3"; shift 3
    : >"$tmp/obs"; printf '%s\n' "$@" >"$tmp/obs"
    set +e; out="$(_compare_leg A "$tmp/ran" "$tmp/obs")"; rc=$?; set -e
    if [ "$rc" = "$want" ] && printf '%s' "$out" | grep -qF -- "$needle"; then
      echo "  [PASS] selftest $name (rc=$rc)"
    else
      echo "  [FAIL] selftest $name — rc=$rc want=$want, needle: $needle"
      echo "$out" | sed 's/^/         /'
      fails=$((fails+1))
    fi
  }

  # TASK-608: the reader, against a REAL artifact this gate produced the way a
  # leg does. These arms are the descendants of TASK-573's parser cases — the
  # defect they guard is unchanged (a verdict the producer can WRITE that the
  # consumer cannot READ scores MISSING, and MISSING reads as a regression), but
  # the surface is now a schema instead of a regex, so the arms also cover the
  # failures a schema has and prose does not: a stale document, a missing one,
  # and an unknown schema major.
  #
  # `_mkart` writes an artifact with the given `id VERDICT` pairs and token.
  _mkart() { # file token version [id verdict]...
    local f="$1" tok="$2" ver="$3"; shift 3
    local rows="" id v
    while [ $# -gt 0 ]; do
      id="$1"; v="$2"; shift 2
      [ -z "$rows" ] || rows="$rows,"
      rows="$rows{\"id\":\"$id\",\"verdict\":\"$v\"}"
    done
    printf '{"schema":{"name":"esp_spotify.test-run","version":"%s"},' "$ver" >"$f"
    printf '"run":{"run_token":"%s","exit_code":0},"results":[%s]}\n' "$tok" "$rows" >>"$f"
  }

  _acase() { # name token_used [id verdict]... -- expected_output
    local name="$1" tok="$2"; shift 2
    local args=() want=""
    while [ $# -gt 0 ]; do
      if [ "$1" = "--" ]; then shift; want="$1"; break; fi
      args+=("$1"); shift
    done
    _mkart "$tmp/art.json" "nonce-real" "1.0" "${args[@]}"
    local got
    got="$(_read_artifact "$tmp/art.json" "$tok" 2>/dev/null || echo "REFUSED")"
    if [ "$got" = "$want" ]; then
      echo "  [PASS] selftest $name"
    else
      echo "  [FAIL] selftest $name — read '$got' want '$want'"; fails=$((fails+1))
    fi
  }

  echo "── run/player-gate --selftest — negative tests of the comparator ──"
  _acase "reader: FLAKY-PASS is read WHOLE, not as a 'FLAKY' fragment (TASK-573)" \
         "nonce-real" T_PMT_04 FLAKY-PASS -- "T_PMT_04 FLAKY-PASS"
  _acase "reader: unresolved FLAKE is distinct from FLAKY-PASS" \
         "nonce-real" T_PMT_04 FLAKE -- "T_PMT_04 FLAKE"
  _acase "reader: NOT-RUN is read whole" \
         "nonce-real" T_PMT_03 NOT-RUN -- "T_PMT_03 NOT-RUN"
  _acase "reader: UNMET is read whole (ADR-066 D5)" \
         "nonce-real" T_PMT_03 UNMET -- "T_PMT_03 UNMET"
  _acase "reader: plain PASS" "nonce-real" T_PMT_00 PASS -- "T_PMT_00 PASS"
  # THE staleness arm. A leg's OUT_DIR holds a previous run's artifact at the
  # same path; the nonce differs; the reader must REFUSE it rather than score
  # the leg against results this run never produced.
  _acase "reader: a PREVIOUS run's artifact at this path is REFUSED, not read" \
         "nonce-this-run" T_PMT_00 PASS T_PMT_01 PASS -- "REFUSED"
  rm -f "$tmp/art.json"
  if [ "$(_read_artifact "$tmp/art.json" "n" 2>/dev/null || echo REFUSED)" = "REFUSED" ]; then
    echo "  [PASS] selftest reader: a MISSING artifact is refused, not an empty result set"
  else
    echo "  [FAIL] selftest reader: a missing artifact must not read as zero results"
    fails=$((fails+1))
  fi
  _mkart "$tmp/art.json" "n" "2.0" T_PMT_00 PASS
  if [ "$(_read_artifact "$tmp/art.json" "n" 2>/dev/null || echo REFUSED)" = "REFUSED" ]; then
    echo "  [PASS] selftest reader: an unknown schema MAJOR is refused, not guessed"
  else
    echo "  [FAIL] selftest reader: schema major 2 must not be parsed by a v1 reader"
    fails=$((fails+1))
  fi
  rm -f "$tmp/art.json"
  _case "green run passes"              0 "T_PMT_00 PASS" "T_PMT_01 PASS" "T_PLR_09 SKIP"
  _case "declared PASS observed FAIL"   1 "T_PMT_00 PASS" "T_PMT_01 FAIL" "T_PLR_09 SKIP"
  _case "declared PASS went MISSING"    1 "T_PMT_00 PASS" "T_PLR_09 SKIP"
  _case "leg aborted, nothing observed" 1 ""
  _case "declared PASS degraded to SKIP" 1 "T_PMT_00 PASS" "T_PMT_01 SKIP" "T_PLR_09 SKIP"
  _case "declared SKIP observed FAIL"   1 "T_PMT_00 PASS" "T_PMT_01 PASS" "T_PLR_09 FAIL"
  _case "declared SKIP observed PASS is not a failure" \
                                        0 "T_PMT_00 PASS" "T_PMT_01 PASS" "T_PLR_09 PASS"
  _case "FLAKE is not a PASS"           1 "T_PMT_00 FLAKE" "T_PMT_01 PASS" "T_PLR_09 SKIP"
  # TASK-573: the unresolved-flake line must KEEP regressing against a declared
  # PASS — that behaviour is correct and the FLAKY-PASS fix must not weaken it.
  _case "unresolved FLAKE still REGRESSes against a declared PASS" \
                                        1 "T_PMT_00 PASS" "T_PMT_01 FLAKE" "T_PLR_09 SKIP"
  # TASK-573: a declared flake that passed on its mandated retry is neither a pass
  # nor a regression — it gets the `flaky` line and does not fail the leg.
  _case_line "declared PASS observed FLAKY-PASS is reported, not fatal" 0 \
             "flaky     A T_PMT_01  FLAKY-PASS (declared PASS)" \
             "T_PMT_00 PASS" "T_PMT_01 FLAKY-PASS" "T_PLR_09 SKIP"
  _case_line "declared SKIP observed FLAKY-PASS is reported, not fatal" 0 \
             "flaky     A T_PLR_09  FLAKY-PASS (declared SKIP)" \
             "T_PMT_00 PASS" "T_PMT_01 PASS" "T_PLR_09 FLAKY-PASS"
  # TASK-573: a declared cell that never ran verified nothing — fatal (TASK-566).
  _case_line "declared PASS observed NOT-RUN is fatal" 1 \
             "NOT-RUN   A T_PMT_01  declared PASS but never ran" \
             "T_PMT_00 PASS" "T_PMT_01 NOT-RUN" "T_PLR_09 SKIP"

  # ── TASK-624 / ADR-066 D5: the UNMET arm (R38, BP-068) ─────────────────────
  # THE INVERSION THIS ARM EXISTS FOR: "an UNMET cell reads green". It is the
  # same defect as TASK-573's, one token later — a status lib/results.py can
  # write that this comparator cannot read is DROPPED, scores MISSING, and the
  # gate then reports a firmware regression that never happened. WP-C found
  # T-BUSY-05 passing on exactly the regression it existed to catch; a gating
  # change with no negative test repeats that at the framework level.
  # TASK-608: these two are now reader arms above (UNMET read whole, NOT-RUN read
  # whole). They are kept here as the ONE assertion the reader arms cannot make
  # on their own — that the two verdicts stay DISTINCT in a single document, so
  # `UNMET` cannot quietly become a second spelling of `NOT-RUN` (IFC-008 I3).
  _acase "reader: UNMET and NOT-RUN stay distinct in one document" "nonce-real" \
         T_PMT_02 UNMET T_PMT_03 NOT-RUN -- "T_PMT_02 UNMET
T_PMT_03 NOT-RUN"
  _case_line "declared PASS observed UNMET is fatal, and says so distinctly" 1 \
             "UNMET     A T_PMT_01  declared PASS but its premise was never established" \
             "T_PMT_00 PASS" "T_PMT_01 UNMET" "T_PLR_09 SKIP"
  # A declared SKIP is the one that would have read GREEN before this row: an
  # UNMET used to BE a SKIP (R28), so SKIP:SKIP scored `ok` and the cell passed.
  _case_line "declared SKIP observed UNMET is fatal — the exact pre-TASK-624 green" 1 \
             "UNMET     A T_PLR_09  declared SKIP but its premise was never established" \
             "T_PMT_00 PASS" "T_PMT_01 PASS" "T_PLR_09 UNMET"
  _case "an UNMET cell never reads green under ANY declaration" \
        1 "T_PMT_00 UNMET" "T_PMT_01 PASS" "T_PLR_09 SKIP"
  # an un-adjudicated baseline row (expected=resv) must not be read as declared
  printf 'T_PMT_00\nT_PMT_01\nT_PLR_09\nT_PLR_99\n' >"$tmp/ran"
  _case "un-adjudicated row is invisible, and its FAIL still fails" \
                                        1 "T_PMT_00 PASS" "T_PMT_01 PASS" "T_PLR_09 SKIP" "T_PLR_99 FAIL"
  _case "un-adjudicated row passing is only drift" \
                                        0 "T_PMT_00 PASS" "T_PMT_01 PASS" "T_PLR_09 SKIP" "T_PLR_99 PASS"
  # TASK-624: and an UNDECLARED cell that asserted nothing is not drift either.
  _case_line "un-baselined UNMET is fatal, not bookkeeping drift" 1 \
             "UNMET     A T_PLR_99  premise never established" \
             "T_PMT_00 PASS" "T_PMT_01 PASS" "T_PLR_09 SKIP" "T_PLR_99 UNMET"

  # TASK-566 / EC-G7: the exit-4 leg. An untaught consumer treats it as a
  # COMPLETED leg and prints REGRESS — the inversion this design exists to
  # prevent, and the one that already happened for FLAKY-PASS.
  set +e
  ( _SETUP_FAIL=0; _HEALTH_FAIL=0; _RC=0
    _run_runner_leg() { local rc=4
      if [ "$rc" = "$SETUP_FAIL_EXIT" ]; then _SETUP_FAIL=1; _RC=3; return 3; fi
      if [ "$rc" = "$HEALTH_FAIL_EXIT" ]; then _HEALTH_FAIL=1; _RC=4; return 4; fi
      return 0; }
    _run_runner_leg A x y >/dev/null 2>&1
    [ "$_HEALTH_FAIL" = "1" ] && [ "$_RC" = "4" ] && [ "$_SETUP_FAIL" = "0" ]
  )
  rc=$?; set -e
  if [ "$rc" = "0" ]; then echo "  [PASS] selftest exit-4 leg sets _HEALTH_FAIL and _RC=4, not _SETUP_FAIL"
  else echo "  [FAIL] selftest exit-4 leg — an exit-4 leg was not distinguished from 3"; fails=$((fails+1)); fi
  set +e
  ( DUT_HEALTH=warn; _assert_health_premise ) >/dev/null 2>&1
  rc=$?; set -e
  if [ "$rc" = "2" ]; then echo "  [PASS] selftest DUT_HEALTH=warn refuses to emit a verdict (rc=2, §18.2)"
  else echo "  [FAIL] selftest DUT_HEALTH=warn — rc=$rc want=2"; fails=$((fails+1)); fi
  set +e
  ( DUT_HEALTH=gate; _assert_health_premise ) >/dev/null 2>&1
  rc=$?; set -e
  if [ "$rc" = "0" ]; then echo "  [PASS] selftest DUT_HEALTH=gate (the default) is accepted"
  else echo "  [FAIL] selftest DUT_HEALTH=gate — rc=$rc want=0"; fails=$((fails+1)); fi

  # TASK-597: the exit-4 mapping above is only real if the runner invocation
  # actually asks for the HEALTH phase — without --health-phase the runner
  # never reaches HEALTH_FAIL_EXIT and every branch above is decorative
  # (E-13, M-TESTQUAL-Z-findings-review.md line 149). Source-grep, not a DUT
  # call: this guards the wiring, not the runner's own behaviour (that is
  # app/tools/test_class_order.py's job).
  _leg_body="$(sed -n '/^_run_runner_leg()/,/^}/p' "$0")"
  if printf '%s' "$_leg_body" | grep -q -- '--health-phase' \
      && printf '%s' "$_leg_body" | grep -q -- '--health-ids T_DH_01,T_DH_03'; then
    echo "  [PASS] selftest _run_runner_leg asks for the HEALTH phase, EXP-040's subset"
  else
    echo "  [FAIL] selftest _run_runner_leg lost --health-phase or EXP-040's subset — exit 4 is unreachable again"
    fails=$((fails+1))
  fi

  # condition (a) is a hard refusal
  set +e
  ( ALLOW_NO_CROSSMODE=0; _assert_crossmode A "T_PLR_01,T_PLR_02" ) >/dev/null 2>&1
  rc=$?; set -e
  if [ "$rc" = "2" ]; then echo "  [PASS] selftest condition (a) refuses a leg with no cross-mode cell (rc=2)"
  else echo "  [FAIL] selftest condition (a) — rc=$rc want=2"; fails=$((fails+1)); fi
  set +e
  ( _assert_crossmode A "T_PLR_01,T_PMT_02" ) >/dev/null 2>&1; rc=$?; set -e
  if [ "$rc" = "0" ]; then echo "  [PASS] selftest condition (a) accepts a leg with one"
  else echo "  [FAIL] selftest condition (a) accept — rc=$rc want=0"; fails=$((fails+1)); fi

  echo ""
  if [ "$fails" = "0" ]; then echo "selftest: all green"; return 0; fi
  echo "selftest: $fails FAILED"; return 1
}

if [ "${1:-}" = "--selftest" ]; then _selftest; exit $?; fi

# ── real run ─────────────────────────────────────────────────────────────────
[ -r "$BASELINE" ] || { echo "ERROR [player-gate]: pass set unreadable: $BASELINE" >&2; exit 2; }
if [ -z "$(_baseline_rows "$BASELINE")" ]; then
  echo "ERROR [player-gate]: pass set has no adjudicated rows: $BASELINE" >&2; exit 2
fi

_PORT_EXPLICIT="${PORT:-}"
PORT=$(resolve_port)
OUT_DIR="${OUT_DIR:-$(mktemp -d -t player-gate-XXXXXX)}"
mkdir -p "$OUT_DIR"

_RC=0
_SETUP_FAIL=0
_HEALTH_FAIL=0
_cleanup() {
  # $? here is the status that triggered the trap. A refusal path uses `exit 2`
  # and never sets _RC, so taking _RC unconditionally reported 0 for a run that
  # had explicitly refused — the trap silently converted a refusal into success.
  # Found by negative-testing this script (BP-068).
  local trigger=$?
  local rc=$_RC
  [ "$rc" = "0" ] && [ "$trigger" != "0" ] && rc=$trigger
  local restore_pt; restore_pt=$(restore_port "$PORT" "$_PORT_EXPLICIT")
  echo ""
  # ADR-067 D1: the production restore that used to run here is DELETED, not
  # guarded. A gate does not own firmware lifecycle. The board keeps whatever
  # build the last flash put there — including a leg-B build after a two-leg run.
  echo "[player-gate] restarting monitor (firmware NOT restored — ADR-067)"
  restart_monitor "$restore_pt"
  # run/test's step-6 lesson (TASK-434 item 1): a rig condition must be re-stated
  # LAST, because a reader greps the tail for the verdict and finds neither PASS
  # nor FAIL.
  if [ "$_SETUP_FAIL" = "1" ]; then
    echo ""
    echo "[SETUP-FAIL] rig condition — NO VERDICT. This is not a gate failure."
    echo "             Artifacts: $OUT_DIR"
  fi
  if [ "$_HEALTH_FAIL" = "1" ]; then
    echo ""
    echo "[HEALTH-FAIL] the board was not a valid test subject — NO VERDICT."
    echo "              This is not a gate failure and not a rig condition."
    echo "              Artifacts: $OUT_DIR"
  fi
  echo "[player-gate] artifacts: $OUT_DIR"
  exit "$rc"
}
case "$LEGS" in *[!AB,]*) echo "ERROR [player-gate]: LEGS must be A, B or A,B (got '$LEGS')" >&2; exit 2 ;; esac
_want_leg() { case ",$LEGS," in *,"$1",*) return 0 ;; esac; return 1; }

# ── precondition validation — BEFORE the trap arms ──────────────────────────
# Deliberately ahead of `trap _cleanup`: a config error (bad leg name, a leg with
# no cross-mode cell) must refuse WITHOUT touching the DUT. When these ran after
# the trap was installed, refusing still triggered a full production reflash, and
# on a busy port that reflash failed and reported 99 — a config typo looked like
# a hardware fault. Found by negative-testing this script (BP-068).
_assert_health_premise

_want_leg A && _assert_crossmode A "$LEG_A_TESTS"
if _want_leg B; then
  _b_all="$LEG_B_TESTS"
  [ "$SKIP_SCRIPTS" = "1" ] || _b_all="$_b_all,T_PLR_13_playback,T_PLR_25_playback"
  _assert_crossmode B "$_b_all"
fi

trap _cleanup EXIT INT TERM

_require_leg_build() { # $1 = env
  # ADR-067 D1/TASK-633. This used to be _flash(): it uploaded $1 and the leg's
  # ELF guard then verified what it had just written, which is a tautology
  # wearing a check's clothes. Now the leg DECLARES the build it needs and the
  # board is READ. A mismatch is exit 3 — RIG, `elf-mismatch` — and the caller
  # flashes it themselves with run/flash-player / run/flash-debug.
  #
  # SKIP_FLASH is gone with the flash it named. There is nothing left to skip:
  # not flashing is now the only behaviour, and the verification it used to
  # leave running is now the whole function.
  require_build "$1" player-gate "$PORT" || return $?
  # BP-018-class: require_build stamps the reset gap after its own port open, so
  # lib/dut.py waits out the remainder before the leg's runner opens the port.
}

# $1=leg $2=env $3=id list -> writes $OUT_DIR/leg$1.{log,results,ran}
_run_runner_leg() {
  local leg="$1" env="$2" ids="$3" rc=0
  local log="$OUT_DIR/leg$leg.log"
  echo "$ids" | tr ',' '\n' | sed '/^$/d' > "$OUT_DIR/leg$leg.ran"
  echo ""
  echo "[player-gate] leg $leg — $env — $(wc -l <"$OUT_DIR/leg$leg.ran") runner cells"
  # TASK-608 layer 2. A fresh nonce per leg, and the target path is REMOVED
  # first: leg B must never be scored against leg A's artifact, and no leg may
  # be scored against a rerun's leftovers in the same OUT_DIR. Removing is the
  # cheap guard; the nonce is the one that actually holds, because it survives
  # a forgotten rm, a racing run and a hand-copied file.
  local art="$OUT_DIR/leg$leg.artifact.json"
  local nonce="pg-$leg-$$-$(date -u +%Y%m%d%H%M%S)"
  rm -f "$art"
  set +e
  # TASK-597: --health-phase makes the runner's HEALTH gate (and its exit-4
  # path) real for this leg WITHOUT adopting --class-order (TASK-566 stays
  # held OFF — TASK-617 RULED 2026-09-03). DUT_HEALTH is inherited from this
  # script's own environment, same as always; _assert_health_premise() above
  # already refused the run before this point if it was warn|skip.
  #
  # The SUBSET is EXP-040's measured decision, not a guess:
  #   T_DH_01  the console answers correct data — this gate reads everything
  #            it scores through that console, so it is the premise for all of it
  #   T_DH_03  app switching is alive — this gate is a MODE-transition gate,
  #            so switch health is its subject's own precondition
  # Deliberately NOT T_DH_02 (network): this gate exercises local SD playback
  # and has never needed the network, so a wifi blip could only refuse it —
  # measured PASS at zero arena cost, and still excluded, because the risk was
  # never cost. Deliberately NOT T_DH_05 (GRAM readback): nothing here reads
  # the panel back. See EXP-040 §6/§7 for the numbers and the residual.
  ( cd "$PIO_DIR" && DUT_ENV="$env" RESULTS_JSON="$art" RESULTS_RUN_TOKEN="$nonce" \
      "$VENV_PY" -u tools/suite/serialdbg/runner.py \
      --port "$PORT" --tests "$ids" \
      --health-phase --health-ids T_DH_01,T_DH_03 ) 2>&1 | tee "$log"
  rc=${PIPESTATUS[0]}
  set -e
  : > "$OUT_DIR/leg$leg.results"
  if ! _read_artifact "$art" "$nonce" > "$OUT_DIR/leg$leg.results"; then
    # The artifact is missing, unreadable, stale or at an unknown schema major.
    # NOT a silent empty result set: every declared cell then scores MISSING and
    # the leg regresses, which is the correct reading of "this run produced no
    # machine-readable verdicts" — but the reader must be told WHICH it was.
    : > "$OUT_DIR/leg$leg.results"
    echo "ERROR [player-gate]: leg $leg produced no usable run artifact ($art)." >&2
    echo "  Every declared cell for this leg will score MISSING. That is not a" >&2
    echo "  firmware statement — it means the run did not reach its summary, or" >&2
    echo "  the file at that path was not this run's (TASK-608 / IFC-008)." >&2
  fi
  if [ "$rc" = "$SETUP_FAIL_EXIT" ]; then
    echo "ERROR [player-gate]: leg $leg exited SETUP_FAIL ($rc) — rig condition, no verdict" >&2
    _SETUP_FAIL=1; _RC=3
    return 3
  fi
  if [ "$rc" = "$HEALTH_FAIL_EXIT" ]; then
    echo "ERROR [player-gate]: leg $leg exited HEALTH_FAIL ($rc) — the BOARD was" >&2
    echo "  not a valid test subject. NO VERDICT: every cell in this leg is" >&2
    echo "  NOT-RUN, and a gate run against an unfit subject verifies nothing." >&2
    echo "  This is NOT a rig condition — do not blame the cable or the port." >&2
    _HEALTH_FAIL=1; _RC=4
    return 4
  fi
  return 0
}

# A standalone playback script is ONE cell: exit 0 = PASS, anything else = FAIL.
# There is no per-id output to parse — that is the whole contract these two have.
_run_script_cell() {
  local leg="$1" id="$2" script="$3" rc=0
  echo ""
  echo "[player-gate] leg $leg — cell $id — $script"
  set +e
  ( cd "$PIO_DIR" && "$VENV_PY" -u "tools/$script" --port "$PORT" --settle-s "$SETTLE_S" ) \
    2>&1 | tee -a "$OUT_DIR/leg$leg.log"
  rc=${PIPESTATUS[0]}
  set -e
  echo "$id" >> "$OUT_DIR/leg$leg.ran"
  if [ "$rc" = "0" ]; then echo "$id PASS" >> "$OUT_DIR/leg$leg.results"
  else echo "$id FAIL" >> "$OUT_DIR/leg$leg.results"; fi
  echo "[player-gate] cell $id rc=$rc"
  sleep 10   # DRD gap before the next serial open
}



echo "[player-gate] pass set: $BASELINE"
echo "[player-gate] legs: $LEGS   port: $PORT   artifacts: $OUT_DIR"


